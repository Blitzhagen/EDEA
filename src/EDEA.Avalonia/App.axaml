<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EDEA.Avalonia.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#1A0F05"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#2A1A0A"/>
    <SolidColorBrush x:Key="CardBrush" Color="#331E0C"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF6A00"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DimForegroundBrush" Color="#AAAAAA"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#FF6A00"/>
    <SolidColorBrush x:Key="MainColor" Color="#FF6A00"/>
    <SolidColorBrush x:Key="MainBackgroundColor" Color="#1A0F05"/>
    <SolidColorBrush x:Key="TitleBarColor" Color="#2A1A0A"/>
    <SolidColorBrush x:Key="MainCellColor" Color="#331E0C"/>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
  </Application.Styles>

</Application>
