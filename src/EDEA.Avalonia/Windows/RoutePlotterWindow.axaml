<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:EDEA.Properties;assembly=EDEA.Core"
        x:Class="EDEA.Avalonia.Windows.RoutePlotterWindow"
        Title="{x:Static properties:Resources.RoutePlotterWindow_Title}"
        Height="400" Width="600"
        Background="{StaticResource MainBackgroundColor}"
        Foreground="{StaticResource ForegroundBrush}"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <Grid Margin="20" RowDefinitions="*,Auto">
    <TextBlock Grid.Row="0" Text="Route plotter placeholder" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource DimForegroundBrush}"/>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="{x:Static properties:Resources.RoutePlotterWindow_Cancel}" Padding="16,4" Click="CancelButton_Click"/>
    </StackPanel>
  </Grid>
</Window>
