<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:EDEA.Properties;assembly=EDEA.Core"
        xmlns:colorpicker="clr-namespace:Avalonia.Controls.Primitives;assembly=Avalonia.Controls.ColorPicker"
        x:Class="EDEA.Avalonia.Windows.PreferencesWindow"
        x:Name="ThisWindow"
        Title="{x:Static properties:Resources.PreferencesWindow_Title}"
        Height="617" MinHeight="617" Width="880" MinWidth="880"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        RequestedThemeVariant="Light"
        Background="#FFFFFF"
        Foreground="#000000">
  <Window.Resources>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#000000"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#000000"/>
    <SolidColorBrush x:Key="DimForegroundBrush" Color="#555555"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#AAAAAA"/>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="12" />
      <ColumnDefinition />
      <ColumnDefinition Width="12" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="13" />
      <RowDefinition />
      <RowDefinition Height="70" />
    </Grid.RowDefinitions>

    <TabControl Grid.Column="1" Grid.Row="1" Focusable="False">
      <TabItem Header="{x:Static properties:Resources.PreferencesWindow_Tab_Appearance}">
        <Grid>
          <Border Classes="PreferencesTabContent">
            <StackPanel Orientation="Horizontal">
              <StackPanel Classes="PreferencesSection">
                <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_Colors}" Classes="PreferencesSectionHeadline" />
                <Border Classes="PreferencesSectionBody">
                  <StackPanel Orientation="Horizontal">
                    <ListBox x:Name="ColorListBox" Classes="PreferencesListbox" SelectionChanged="ColorListBox_SelectionChanged" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource ForegroundBrush}" />
                    <StackPanel Spacing="4" Width="170">
                      <colorpicker:ColorSpectrum x:Name="ColorSpectrum" Width="150" Height="150" Shape="Ring" Components="HueSaturation" Color="{Binding SelectedColor, ElementName=ThisWindow, Mode=TwoWay}" />
                      <TabControl x:Name="ColorModelTabControl" Padding="0" Margin="0">
                        <TabItem Header="HSV">
                          <StackPanel Spacing="2">
                            <colorpicker:ColorSlider Color="{Binding SelectedColor, ElementName=ThisWindow, Mode=TwoWay}" ColorModel="Hsva" ColorComponent="Component1" />
                            <colorpicker:ColorSlider Color="{Binding SelectedColor, ElementName=ThisWindow, Mode=TwoWay}" ColorModel="Hsva" ColorComponent="Component2" />
                            <colorpicker:ColorSlider Color="{Binding SelectedColor, ElementName=ThisWindow, Mode=TwoWay}" ColorModel="Hsva" ColorComponent="Component3" />
                          </StackPanel>
                        </TabItem>
                        <TabItem Header="RGB">
                          <StackPanel Spacing="2">
                            <colorpicker:ColorSlider Color="{Binding SelectedColor, ElementName=ThisWindow, Mode=TwoWay}" ColorModel="Rgba" ColorComponent="Component1" />
                            <colorpicker:ColorSlider Color="{Binding SelectedColor, ElementName=ThisWindow, Mode=TwoWay}" ColorModel="Rgba" ColorComponent="Component2" />
                            <colorpicker:ColorSlider Color="{Binding SelectedColor, ElementName=ThisWindow, Mode=TwoWay}" ColorModel="Rgba" ColorComponent="Component3" />
                          </StackPanel>
                        </TabItem>
                      </TabControl>
                      <TextBox x:Name="HexColorTextBox" Watermark="#RRGGBB" Width="120" HorizontalAlignment="Left" LostFocus="HexColorTextBox_LostFocus" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel>
                <StackPanel Classes="PreferencesSection">
                  <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_DisplaySize}" Classes="PreferencesSectionHeadline" />
                  <Border Classes="PreferencesSectionBody">
                    <StackPanel>
                      <RadioButton x:Name="DisplaySizeSmall" Classes="PreferencesRadioButton" Content="{x:Static properties:Resources.PreferencesWindow_Radio_Small}" GroupName="DisplaySize" IsCheckedChanged="DisplaySize_Changed" />
                      <RadioButton x:Name="DisplaySizeStandard" Classes="PreferencesRadioButton" Content="{x:Static properties:Resources.PreferencesWindow_Radio_Standard}" GroupName="DisplaySize" IsCheckedChanged="DisplaySize_Changed" />
                      <RadioButton x:Name="DisplaySizeLarge" Classes="PreferencesRadioButton" Content="{x:Static properties:Resources.PreferencesWindow_Radio_Large}" GroupName="DisplaySize" IsCheckedChanged="DisplaySize_Changed" />
                      <RadioButton x:Name="DisplaySizeHuge" Classes="PreferencesRadioButton" Content="{x:Static properties:Resources.PreferencesWindow_Radio_Huge}" GroupName="DisplaySize" IsCheckedChanged="DisplaySize_Changed" />
                    </StackPanel>
                  </Border>
                </StackPanel>
                <StackPanel Classes="PreferencesSection">
                  <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_Behavior}" Classes="PreferencesSectionHeadline" />
                  <Border Classes="PreferencesSectionBody">
                    <StackPanel>
                      <CheckBox x:Name="AutomaticTabSwitchingCheckBox" Content="{x:Static properties:Resources.PreferencesWindow_Checkbox_AutomaticTabSwitching}" IsCheckedChanged="AutomaticTabSwitching_Changed" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="{x:Static properties:Resources.PreferencesWindow_Tab_HudWindow}">
        <Grid>
          <Border Classes="PreferencesTabContent">
            <StackPanel Orientation="Horizontal">
              <StackPanel Classes="PreferencesSection">
                <TextBlock Text="Columns" Classes="PreferencesSectionHeadline" />
                <Border Classes="PreferencesSectionBody">
                  <StackPanel x:Name="HudPanel" Width="185" Spacing="4" />
                </Border>
              </StackPanel>
              <StackPanel>
                <StackPanel Classes="PreferencesSection">
                  <TextBlock Text="Opacity" Classes="PreferencesSectionHeadline" />
                  <Border Classes="PreferencesSectionBody">
                    <Slider x:Name="HudOpacitySlider" Minimum="0" Maximum="1" TickFrequency="0.1" Width="200" HorizontalAlignment="Left" ValueChanged="HudOpacitySlider_ValueChanged" />
                  </Border>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="{x:Static properties:Resources.PreferencesWindow_Tab_GlobalHotkeys}">
        <Grid>
          <Border Classes="PreferencesTabContent">
            <StackPanel Classes="PreferencesSection">
              <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_Assignment}" Classes="PreferencesSectionHeadline" />
              <Border Classes="PreferencesSectionBody">
                <ScrollViewer Height="300">
                  <StackPanel x:Name="HotkeysPanel" Spacing="4" />
                </ScrollViewer>
              </Border>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="{x:Static properties:Resources.PreferencesWindow_Tab_Speech}">
        <ScrollViewer>
          <Border Classes="PreferencesTabContent">
            <StackPanel>
              <StackPanel Classes="PreferencesSection">
                <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_Voice}" Classes="PreferencesSectionHeadline" />
                <Border Classes="PreferencesSectionBody">
                  <ComboBox x:Name="SpeechVoiceComboBox" Width="300" HorizontalAlignment="Left" SelectionChanged="SpeechVoiceComboBox_SelectionChanged" />
                </Border>
              </StackPanel>
              <StackPanel Classes="PreferencesSection">
                <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_Rate}" Classes="PreferencesSectionHeadline" />
                <Border Classes="PreferencesSectionBody">
                  <Slider x:Name="SpeechRateSlider" Minimum="-4" Maximum="4" TickFrequency="1" Width="200" HorizontalAlignment="Left" ValueChanged="SpeechRateSlider_ValueChanged" />
                </Border>
              </StackPanel>
              <StackPanel Classes="PreferencesSection">
                <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_Volume}" Classes="PreferencesSectionHeadline" />
                <Border Classes="PreferencesSectionBody">
                  <Slider x:Name="SpeechVolumeSlider" Minimum="0" Maximum="100" TickFrequency="25" Width="200" HorizontalAlignment="Left" ValueChanged="SpeechVolumeSlider_ValueChanged" />
                </Border>
              </StackPanel>
              <StackPanel Classes="PreferencesSection">
                <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_Outputs}" Classes="PreferencesSectionHeadline" />
                <Border Classes="PreferencesSectionBody">
                  <Grid ColumnDefinitions="200,20,*">
                    <ListBox x:Name="SpeechOutputListBox" Grid.Column="0" SelectionChanged="SpeechOutputListBox_SelectionChanged" Height="250">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Column="2" Spacing="8" IsEnabled="{Binding #SpeechOutputListBox.SelectedItem}">
                      <TextBlock x:Name="SpeechOutputLabel" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                      <CheckBox x:Name="SpeechOutputEnabledCheckBox" Content="Enabled" IsCheckedChanged="SpeechOutputEnabledCheckBox_IsCheckedChanged" />
                      <TextBlock Text="Phrase" />
                      <TextBox x:Name="SpeechOutputPhraseTextBox" AcceptsReturn="True" TextWrapping="Wrap" Height="80" Width="400" HorizontalAlignment="Left" TextChanged="SpeechOutputPhraseTextBox_TextChanged" />
                      <TextBlock x:Name="SpeechOutputPlaceholdersTextBlock" Foreground="{StaticResource DimForegroundBrush}" TextWrapping="Wrap" Width="400" HorizontalAlignment="Left" />
                      <Button x:Name="SpeechTestButton" Content="{x:Static properties:Resources.PreferencesWindow_Button_TestSpeechOutput}" Click="SpeechTestButton_Click" HorizontalAlignment="Left" Padding="12,4" />
                    </StackPanel>
                  </Grid>
                </Border>
              </StackPanel>
            </StackPanel>
          </Border>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{x:Static properties:Resources.PreferencesWindow_Tab_PlanetsOfInterest}">
        <ScrollViewer>
          <Border Classes="PreferencesTabContent">
            <StackPanel Classes="PreferencesSection">
              <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_CriteriaSets}" Classes="PreferencesSectionHeadline" />
              <Border Classes="PreferencesSectionBody" MinHeight="385">
                <StackPanel Orientation="Horizontal">
                  <StackPanel>
                    <ListBox x:Name="PlanetClassificationListBox" SelectionMode="Single" Width="170" Height="270" SelectionChanged="PlanetClassificationListBox_SelectionChanged">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding IsActive}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Name}" />
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="1,1,5,10">
                      <Button x:Name="AddPlanetFilterButton" Content="{x:Static properties:Resources.PreferencesWindow_Button_Add}" Click="AddPlanetFilterButton_Click" />
                      <Button x:Name="RenamePlanetFilterButton" Content="{x:Static properties:Resources.PreferencesWindow_Button_Rename}" Click="RenamePlanetFilterButton_Click" />
                      <Button x:Name="DeletePlanetFilterButton" Content="{x:Static properties:Resources.PreferencesWindow_Button_Delete}" Click="DeletePlanetFilterButton_Click" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel x:Name="PlanetDetailPanel" Spacing="8" IsEnabled="False">
                    <TextBlock x:Name="PlanetDetailName" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    <CheckBox x:Name="PlanetDetailActiveCheckBox" Content="Active" IsCheckedChanged="PlanetDetailActiveCheckBox_IsCheckedChanged" />
                    <TextBlock Text="Name" />
                    <TextBox x:Name="PlanetDetailNameTextBox" Width="300" TextChanged="PlanetDetailNameTextBox_TextChanged" />
                    <TextBlock Text="Planet classes" />
                    <TextBox x:Name="PlanetDetailPlanetClassesTextBox" Width="300" TextChanged="PlanetDetailPlanetClassesTextBox_TextChanged" />
                    <TextBlock Text="Star classes" />
                    <TextBox x:Name="PlanetDetailStarClassesTextBox" Width="300" TextChanged="PlanetDetailStarClassesTextBox_TextChanged" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <StackPanel>
                        <TextBlock Text="Distance min" />
                        <TextBox x:Name="PlanetDetailDistanceMinTextBox" Width="120" TextChanged="PlanetDetailDistanceMinTextBox_TextChanged" />
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="Distance max" />
                        <TextBox x:Name="PlanetDetailDistanceMaxTextBox" Width="120" TextChanged="PlanetDetailDistanceMaxTextBox_TextChanged" />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <StackPanel>
                        <TextBlock Text="Radius min" />
                        <TextBox x:Name="PlanetDetailRadiusMinTextBox" Width="120" TextChanged="PlanetDetailRadiusMinTextBox_TextChanged" />
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="Radius max" />
                        <TextBox x:Name="PlanetDetailRadiusMaxTextBox" Width="120" TextChanged="PlanetDetailRadiusMaxTextBox_TextChanged" />
                      </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Landable" />
                    <ComboBox x:Name="PlanetDetailLandableComboBox" Width="120" SelectionChanged="PlanetDetailLandableComboBox_SelectionChanged">
                      <ComboBoxItem Content="Does not matter"/>
                      <ComboBoxItem Content="No"/>
                      <ComboBoxItem Content="Yes"/>
                    </ComboBox>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{x:Static properties:Resources.PreferencesWindow_Tab_Configuration}">
        <ScrollViewer>
          <Border Classes="PreferencesTabContent">
            <StackPanel>
              <StackPanel Classes="PreferencesSection">
                <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_JournalFilesPath}" Classes="PreferencesSectionHeadline" />
                <Border Classes="PreferencesSectionBody">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="EdSavedGamePathTextBox" IsReadOnly="True" Width="600" />
                    <Button x:Name="SetJournalFolderButton" Content="{x:Static properties:Resources.PreferencesWindow_Button_Set}" Click="SetJournalFolderButton_Click" />
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel Classes="PreferencesSection">
                <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_Thresholds}" Classes="PreferencesSectionHeadline" />
                <Border Classes="PreferencesSectionBody">
                  <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static properties:Resources.PreferencesWindow_Label_ValuableBodies}" VerticalAlignment="Center" Margin="0,0,16,8" />
                    <TextBox x:Name="ValuableBodyThresholdTextBox" Grid.Row="0" Grid.Column="1" Width="120" TextChanged="ValuableBodyThresholdTextBox_TextChanged" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static properties:Resources.PreferencesWindow_Label_ValuableSpecies}" VerticalAlignment="Center" Margin="0,0,16,8" />
                    <TextBox x:Name="ValuableGenusThresholdTextBox" Grid.Row="1" Grid.Column="1" Width="120" TextChanged="ValuableGenusThresholdTextBox_TextChanged" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static properties:Resources.PreferencesWindow_Label_BiologicalsViewAltitude}" VerticalAlignment="Center" Margin="0,0,16,8" />
                    <TextBox x:Name="BiologicalsViewAltitudeThresholdTextBox" Grid.Row="2" Grid.Column="1" Width="120" TextChanged="BiologicalsViewAltitudeThresholdTextBox_TextChanged" Margin="0,0,0,8" />
                  </Grid>
                </Border>
              </StackPanel>
              <StackPanel Classes="PreferencesSection">
                <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_ResetPreferences}" Classes="PreferencesSectionHeadline" />
                <Border Classes="PreferencesSectionBody">
                  <Button x:Name="RestoreDefaultButton" Content="{x:Static properties:Resources.PreferencesWindow_ResetPreferences}" Click="RestoreDefaultButton_Click" HorizontalAlignment="Left" Padding="12,4" />
                </Border>
              </StackPanel>
            </StackPanel>
          </Border>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Spacing="8">
      <Button x:Name="OkButton" Content="{x:Static properties:Resources.PreferencesWindow_Save}" Padding="16,4" Click="OkButton_Click" />
      <Button x:Name="CancelButton" Content="{x:Static properties:Resources.PreferencesWindow_Cancel}" Padding="16,4" Click="CancelButton_Click" />
    </StackPanel>
  </Grid>
</Window>
