<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:EDEA.Properties;assembly=EDEA.Core"
        xmlns:local="clr-namespace:EDEA;assembly=EDEA.Core"
        xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker.AvaloniaUI"
        x:Class="EDEA.Avalonia.Windows.PreferencesWindow"
        x:Name="ThisWindow"
        Title="{x:Static properties:Resources.PreferencesWindow_Title}"
        Height="617" MinHeight="617" Width="880" MinWidth="880"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        RequestedThemeVariant="Light"
        Background="#FFFFFF"
        Foreground="#000000">
  <Window.Resources>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#000000"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#000000"/>
    <SolidColorBrush x:Key="DimForegroundBrush" Color="#555555"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#AAAAAA"/>
    <SolidColorBrush x:Key="WindowBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="WindowTextBrush" Color="#000000"/>
    <SolidColorBrush x:Key="ActiveBorderBrush" Color="#B0B0B0"/>
    <SolidColorBrush x:Key="GrayTextBrush" Color="#6D6D6D"/>
  </Window.Resources>
  <Window.Styles>
    <SimpleTheme />
  </Window.Styles>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="12" />
      <ColumnDefinition />
      <ColumnDefinition Width="12" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="13" />
      <RowDefinition />
      <RowDefinition Height="70" />
    </Grid.RowDefinitions>

    <TabControl Grid.Column="1" Grid.Row="1" Focusable="False">
      <TabItem Header="{x:Static properties:Resources.PreferencesWindow_Tab_Appearance}">
        <Grid>
          <Border Classes="PreferencesTabContent">
            <StackPanel Orientation="Horizontal">
              <StackPanel Classes="PreferencesSection">
                <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_Colors}" Classes="PreferencesSectionHeadline" />
                <Border Classes="PreferencesSectionBody">
                  <StackPanel Orientation="Horizontal">
                    <ListBox x:Name="ColorListBox" Classes="PreferencesListbox" SelectionChanged="ColorListBox_SelectionChanged" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource ForegroundBrush}" />
                    <StackPanel Spacing="4" Width="170">
                      <colorpicker:SquarePicker x:Name="SquarePicker" SelectedColor="{Binding SelectedColor, ElementName=ThisWindow, Mode=TwoWay}" />
                      <colorpicker:ColorSliders x:Name="ColorSliders" ShowAlpha="False" Color="{Binding SelectedColor, ElementName=ThisWindow, Mode=TwoWay}" />
                      <colorpicker:HexColorTextBox x:Name="HexColorTextBox" ShowAlpha="False" Color="{Binding SelectedColor, ElementName=ThisWindow, Mode=TwoWay}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel>
                <StackPanel Classes="PreferencesSection">
                  <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_DisplaySize}" Classes="PreferencesSectionHeadline" />
                  <Border Classes="PreferencesSectionBody">
                    <StackPanel>
                      <RadioButton x:Name="DisplaySizeSmall" Classes="PreferencesRadioButton" Content="{x:Static properties:Resources.PreferencesWindow_Radio_Small}" GroupName="DisplaySize" IsCheckedChanged="DisplaySize_Changed" />
                      <RadioButton x:Name="DisplaySizeStandard" Classes="PreferencesRadioButton" Content="{x:Static properties:Resources.PreferencesWindow_Radio_Standard}" GroupName="DisplaySize" IsCheckedChanged="DisplaySize_Changed" />
                      <RadioButton x:Name="DisplaySizeLarge" Classes="PreferencesRadioButton" Content="{x:Static properties:Resources.PreferencesWindow_Radio_Large}" GroupName="DisplaySize" IsCheckedChanged="DisplaySize_Changed" />
                      <RadioButton x:Name="DisplaySizeHuge" Classes="PreferencesRadioButton" Content="{x:Static properties:Resources.PreferencesWindow_Radio_Huge}" GroupName="DisplaySize" IsCheckedChanged="DisplaySize_Changed" />
                    </StackPanel>
                  </Border>
                </StackPanel>
                <StackPanel Classes="PreferencesSection">
                  <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_Behavior}" Classes="PreferencesSectionHeadline" />
                  <Border Classes="PreferencesSectionBody">
                    <StackPanel>
                      <CheckBox x:Name="AutomaticTabSwitchingCheckBox" Content="{x:Static properties:Resources.PreferencesWindow_Checkbox_AutomaticTabSwitching}" IsCheckedChanged="AutomaticTabSwitching_Changed" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="{x:Static properties:Resources.PreferencesWindow_Tab_HudWindow}">
        <Grid>
          <Border Classes="PreferencesTabContent">
            <StackPanel Orientation="Horizontal">
              <StackPanel Classes="PreferencesSection">
                <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_Columns}" Classes="PreferencesSectionHeadline" />
                <Border Classes="PreferencesSectionBody">
                  <StackPanel Width="185">
                    <ComboBox x:Name="HudColumnComboBox" SelectedIndex="0" Classes="PreferencesComboBox" SelectionChanged="HudColumnComboBox_SelectionChanged">
                      <ComboBoxItem Content="{x:Static properties:Resources.PreferencesWindow_Bodies}" />
                      <ComboBoxItem Content="{x:Static properties:Resources.PreferencesWindow_Route}" />
                      <ComboBoxItem Content="{x:Static properties:Resources.PreferencesWindow_Biologicals}" />
                    </ComboBox>
                    <StackPanel x:Name="HudBodiesPanel" IsVisible="True">
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static local:Globals.ColumnHeaderName}" IsChecked="True" IsEnabled="False" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static local:Globals.ColumnHeaderType}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="BodiesColumnTypeVisible" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static local:Globals.ColumnHeaderAtmosphere}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="BodiesColumnAtmosphereVisible" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static local:Globals.ColumnHeaderTemperature}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="BodiesColumnTemperatureVisible" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static properties:Resources.PreferencesWindow_BodiesColumn_SurfaceScanIcon}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="BodiesColumnSurfaceScannedIconVisible" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static properties:Resources.PreferencesWindow_BodiesColumn_PlanetOfInterestIcon}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="BodiesColumnPlanetOfInterestIconVisible" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static local:Globals.ColumnHeaderCartographicValue}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="BodiesColumnCartographicValueVisible" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static properties:Resources.PreferencesWindow_BodiesColumn_ValuableBodyIcon}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="BodiesColumnValuableIconVisible" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static properties:Resources.PreferencesWindow_BodiesColumn_RingsIcon}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="BodiesColumnRingsIconVisible" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static properties:Resources.PreferencesWindow_BodiesColumn_GeologicalsIcon}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="BodiesColumnGeologicalsIconVisible" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static properties:Resources.PreferencesWindow_BodiesColumn_BiologicalsIcon}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="BodiesColumnBiologicalsIconVisible" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static properties:Resources.PreferencesWindow_BodiesColumn_TerraformableIcon}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="BodiesColumnTerraformableIconVisible" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static properties:Resources.PreferencesWindow_BodiesColumn_LandableIcon}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="BodiesColumnLandableIconVisible" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static properties:Resources.PreferencesWindow_BodiesColumn_FirstDiscoveryIcon}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="BodiesColumnNewIconVisible" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static local:Globals.ColumnHeaderEdsmDiscoverer}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="BodiesColumnEdsmDiscovererVisible" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static local:Globals.ColumnHeaderDistance}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="BodiesColumnDistanceVisible" />
                    </StackPanel>
                    <StackPanel x:Name="HudRoutePanel" IsVisible="False">
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static local:Globals.ColumnHeaderJump}" IsChecked="True" IsEnabled="False" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static local:Globals.ColumnHeaderSystemName}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="RouteColumnSystemNameVisible" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static properties:Resources.PreferencesWindow_RouteColumn_ScoopableStarIconStarClass}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="RouteColumnStarClassVisible" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static properties:Resources.PreferencesWindow_RouteColumn_ExplorationStatusIcon}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="RouteColumnExplorationStatusIconVisible" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static local:Globals.ColumnHeaderCartographicValue}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="RouteColumnCartographicValueVisible" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static local:Globals.ColumnHeaderOverallProgress}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="RouteColumnProgressVisible" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static properties:Resources.PreferencesWindow_RouteColumn_PlanetOfInterestIcon}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="RouteColumnPlanetOfInterestIconVisible" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static properties:Resources.PreferencesWindow_RouteColumn_ValuableBodiesIcon}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="RouteColumnValuableIconVisible" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static properties:Resources.PreferencesWindow_RouteColumn_TerraformablesIcon}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="RouteColumnTerraformableIconVisible" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static properties:Resources.PreferencesWindow_RouteColumn_LandablesIcon}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="RouteColumnLandableIconVisible" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static properties:Resources.PreferencesWindow_RouteColumn_PopulatedIcon}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="RouteColumnPopulatedIconVisible" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static local:Globals.ColumnHeaderEdsmDiscoverer}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="RouteColumnEdsmDiscovererVisible" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static local:Globals.ColumnHeaderDistance}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="RouteColumnDistanceVisible" />
                    </StackPanel>
                    <StackPanel x:Name="HudGenusPanel" IsVisible="False">
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static local:Globals.ColumnHeaderName}" IsChecked="True" IsEnabled="False" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static local:Globals.ColumnHeaderSpecies}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="GenusColumnSpeciesVisible" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static local:Globals.ColumnHeaderVariant}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="GenusColumnVariantVisible" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static properties:Resources.PreferencesWindow_GenusColumn_AnalysisCompleteIcon}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="GenusColumnAnalysisCompleteIconVisible" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static local:Globals.ColumnHeaderScans}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="GenusColumnScansVisible" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static local:Globals.ColumnHeaderClonalColonyRange}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="GenusColumnClonalColonyRangeVisible" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static local:Globals.ColumnHeader1stScanDistance}" IsChecked="True" IsEnabled="False" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static local:Globals.ColumnHeader2ndScanDistance}" IsChecked="True" IsEnabled="False" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static local:Globals.ColumnHeaderVistaGenomicsValue}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="GenusColumnVistaGenomicsValueVisible" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static properties:Resources.PreferencesWindow_GenusColumn_ValuableSpeciesIcon}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="GenusColumnValuableIconVisible" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static properties:Resources.PreferencesWindow_GenusColumn_FirstDiscoveryIcon}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="GenusColumnNewIconVisible" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel>
                <StackPanel Classes="PreferencesSection">
                  <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_Opacity}" Classes="PreferencesSectionHeadline" />
                  <Border Classes="PreferencesSectionBody">
                    <Slider x:Name="HudOpacitySlider" Minimum="0" Maximum="1" TickFrequency="0.1" Width="200" HorizontalAlignment="Left" ValueChanged="HudOpacitySlider_ValueChanged" />
                  </Border>
                </StackPanel>
                <StackPanel Classes="PreferencesSection">
                  <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_View}" Classes="PreferencesSectionHeadline" />
                  <Border Classes="PreferencesSectionBody">
                    <StackPanel>
                      <RadioButton x:Name="HudViewAutoRadioButton" Classes="PreferencesRadioButton" Content="{x:Static properties:Resources.PreferencesWindow_Radio_SyncedWithMainWindow}" Tag="Auto" IsCheckedChanged="HudViewRadioButton_Changed" />
                      <RadioButton x:Name="HudViewRouteRadioButton" Classes="PreferencesRadioButton" Content="{x:Static properties:Resources.PreferencesWindow_Route}" Tag="NavRouteTableViewModel" IsCheckedChanged="HudViewRadioButton_Changed" />
                      <RadioButton x:Name="HudViewBodiesRadioButton" Classes="PreferencesRadioButton" Content="{x:Static properties:Resources.PreferencesWindow_Bodies}" Tag="BodyTableViewModel" IsCheckedChanged="HudViewRadioButton_Changed" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </StackPanel>
              <StackPanel>
                <StackPanel Classes="PreferencesSection">
                  <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_AutomaticHideOn}" Classes="PreferencesSectionHeadline" />
                  <Border Classes="PreferencesSectionBody">
                    <StackPanel x:Name="HideOnStackPanel">
                      <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_InShipSrvFighter}" Classes="PreferencesCheckBoxesHeadline" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static properties:Resources.PreferencesWindow_HideOn_NoActivePanel}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="HideOnNoFocus" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static properties:Resources.PreferencesWindow_HideOn_InternalPanel}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="HideOnInternalPanel" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static properties:Resources.PreferencesWindow_HideOn_ExternalPanel}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="HideOnExternalPanel" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static properties:Resources.PreferencesWindow_HideOn_CommsPanel}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="HideOnCommsPanel" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static properties:Resources.PreferencesWindow_HideOn_RolePanel}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="HideOnRolePanel" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static properties:Resources.PreferencesWindow_HideOn_StationServices}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="HideOnStationServices" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static properties:Resources.PreferencesWindow_HideOn_GalaxyMap}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="HideOnGalaxyMap" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static properties:Resources.PreferencesWindow_HideOn_SystemMap}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="HideOnSystemMap" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static properties:Resources.PreferencesWindow_HideOn_Orrery}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="HideOnOrrery" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static properties:Resources.PreferencesWindow_HideOn_FssMode}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="HideOnFSSmode" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static properties:Resources.PreferencesWindow_HideOn_SaaMode}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="HideOnSAAmode" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static properties:Resources.PreferencesWindow_HideOn_Codex}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="HideOnCodex" />
                      <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_OnFoot}" Classes="PreferencesCheckBoxesHeadline" />
                      <CheckBox Classes="PreferencesCheckbox" Content="{x:Static properties:Resources.PreferencesWindow_HideOn_Always}" IsCheckedChanged="HudWindowCheckBox_Changed" Tag="HideOnOnFoot" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="{x:Static properties:Resources.PreferencesWindow_Tab_GlobalHotkeys}">
        <Grid>
          <Border Classes="PreferencesTabContent">
            <StackPanel Classes="PreferencesSection">
              <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_Assignment}" Classes="PreferencesSectionHeadline" />
              <Border Classes="PreferencesSectionBody">
                <ScrollViewer Height="300">
                  <ListBox x:Name="HotkeysListBox" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Single">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:CompileBindings="False">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Grid.Column="0" Text="{Binding Value.Description}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding Value.FullKey}" Tag="{Binding Key}" PointerPressed="HotkeyTextBlock_Click" Cursor="Hand" Padding="6,3" HorizontalAlignment="Right" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </ScrollViewer>
              </Border>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="{x:Static properties:Resources.PreferencesWindow_Tab_Speech}">
        <Grid>
          <Border Classes="PreferencesTabContent">
            <StackPanel Orientation="Horizontal">
              <StackPanel Classes="PreferencesSection">
                <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_Outputs}" Classes="PreferencesSectionHeadline" />
                <Border Classes="PreferencesSectionBody">
                  <StackPanel Orientation="Horizontal">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition MinHeight="12" MaxHeight="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition MinHeight="10" MaxHeight="10" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <ListBox x:Name="SpeechOutputListBox" Grid.Row="0" Grid.Column="0" Grid.RowSpan="8" Classes="PreferencesListbox" Width="177" VerticalAlignment="Top" SelectionChanged="SpeechOutputListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:CompileBindings="False">
                            <TextBlock Text="{Binding Label}" />
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                      <TextBlock Grid.Row="0" Grid.Column="2" Text="{x:Static properties:Resources.PreferencesWindow_Label_SpeechOutputText}" Classes="PreferencesBodyHeadline" />
                      <TextBox x:Name="SpeechOutputPhraseTextBox" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Left" ScrollViewer.VerticalScrollBarVisibility="Auto" Width="300" Height="100" Margin="0,2,0,0" TextWrapping="Wrap" MaxLength="500" TextChanged="SpeechOutputPhraseTextBox_TextChanged" />
                      <CheckBox x:Name="SpeechOutputEnabledCheckBox" Grid.Row="2" Grid.Column="2" Content="Enabled" IsCheckedChanged="SpeechOutputEnabledCheckBox_IsCheckedChanged" />
                      <Grid Grid.Row="4" Grid.Column="2">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition MinWidth="132" MaxWidth="132" />
                          <ColumnDefinition MinWidth="10" MaxWidth="10" />
                          <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Static properties:Resources.PreferencesWindow_Label_TextPlaceholder}" Classes="PreferencesBodyHeadlineLight" />
                        <TextBlock Grid.Column="2" Text="{x:Static properties:Resources.PreferencesWindow_Label_Example}" Classes="PreferencesBodyHeadlineLight" />
                      </Grid>
                      <ScrollViewer Grid.Row="5" Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="140" Width="300">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition MinWidth="132" MaxWidth="132" />
                            <ColumnDefinition MinWidth="10" MaxWidth="10" />
                            <ColumnDefinition />
                          </Grid.ColumnDefinitions>
                          <StackPanel x:Name="SpeechOutputPlaceholder" Grid.Column="0" />
                          <StackPanel x:Name="SpeechOutputExamples" Grid.Column="2" />
                        </Grid>
                      </ScrollViewer>
                      <Button x:Name="SpeechTestButton" Grid.Row="7" Grid.Column="2" VerticalAlignment="Top" Content="{x:Static properties:Resources.PreferencesWindow_Button_TestSpeechOutput}" Click="SpeechTestButton_Click" />
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel>
                <StackPanel Classes="PreferencesSection">
                  <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_Voice}" Classes="PreferencesSectionHeadline" />
                  <Border Classes="PreferencesSectionBody">
                    <StackPanel Width="170">
                      <ComboBox x:Name="SpeechVoiceComboBox" Margin="0,0,0,17" SelectionChanged="SpeechVoiceComboBox_SelectionChanged" />
                      <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_Rate}" Classes="PreferencesBodyHeadline" />
                      <Slider x:Name="SpeechRateSlider" Margin="0,0,0,12" Minimum="-4" Maximum="4" TickFrequency="2" ValueChanged="SpeechRateSlider_ValueChanged" />
                      <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_Volume}" Classes="PreferencesBodyHeadline" />
                      <Slider x:Name="SpeechVolumeSlider" Minimum="0" Maximum="100" TickFrequency="25" ValueChanged="SpeechVolumeSlider_ValueChanged" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="{x:Static properties:Resources.PreferencesWindow_Tab_PlanetsOfInterest}">
        <ScrollViewer>
          <Border Classes="PreferencesTabContent">
            <StackPanel Classes="PreferencesSection">
              <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_CriteriaSets}" Classes="PreferencesSectionHeadline" />
              <Border Classes="PreferencesSectionBody" MinHeight="385">
                <StackPanel Orientation="Horizontal">
                  <StackPanel>
                    <ListBox x:Name="PlanetClassificationListBox" SelectionMode="Single" Classes="PreferencesListbox" Width="170" Height="270" Margin="1,1,5,5" SelectionChanged="PlanetClassificationListBox_SelectionChanged">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding IsActive}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Name}" Tag="{Binding Id}" />
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <Button x:Name="AddPlanetFilterButton" Content="{x:Static properties:Resources.PreferencesWindow_Button_Add}" Click="AddPlanetFilterButton_Click" />
                      <Button x:Name="RenamePlanetFilterButton" Content="{x:Static properties:Resources.PreferencesWindow_Button_Rename}" IsEnabled="False" Click="RenamePlanetFilterButton_Click" />
                      <Button x:Name="DeletePlanetFilterButton" Content="{x:Static properties:Resources.PreferencesWindow_Button_Delete}" IsEnabled="False" Click="DeletePlanetFilterButton_Click" />
                    </StackPanel>
                  </StackPanel>
                  <TabControl x:Name="PlanetsOfInterestTabControl" Margin="0,0,0,22" SelectionChanged="PlanetsOfInterestTabControl_SelectionChanged">
                    <TabItem Header="{x:Static properties:Resources.PreferencesWindow_SubTab_BasicAttributes}">
                      <StackPanel x:Name="PlanetBasicAttributesPanel" Orientation="Horizontal" MinWidth="565" IsEnabled="False">
                        <StackPanel Margin="17,15,0,0">
                          <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_DistanceToMainStar}" Classes="PreferencesBodyHeadline" />
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_HigherThan}" Classes="PreferencesBodyHeadlineLight" VerticalAlignment="Center" />
                            <TextBox x:Name="PlanetDistanceMinTextBox" Tag="DistanceMin" MaxLength="7" Width="60" TextChanged="PlanetNumberTextBox_TextChanged" />
                            <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_AndLowerThan}" Classes="PreferencesBodyHeadlineLight" VerticalAlignment="Center" />
                            <TextBox x:Name="PlanetDistanceMaxTextBox" Tag="DistanceMax" MaxLength="7" Width="60" TextChanged="PlanetNumberTextBox_TextChanged" />
                          </StackPanel>
                          <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_BodyRadius}" Classes="PreferencesBodyHeadlineWithTopSpace" />
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_HigherThan}" Classes="PreferencesBodyHeadlineLight" VerticalAlignment="Center" />
                            <TextBox x:Name="PlanetRadiusMinTextBox" Tag="RadiusMin" MaxLength="7" Width="60" TextChanged="PlanetNumberTextBox_TextChanged" />
                            <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_AndLowerThan}" Classes="PreferencesBodyHeadlineLight" VerticalAlignment="Center" />
                            <TextBox x:Name="PlanetRadiusMaxTextBox" Tag="RadiusMax" MaxLength="7" Width="60" TextChanged="PlanetNumberTextBox_TextChanged" />
                          </StackPanel>
                          <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_OrbitalInclination}" Classes="PreferencesBodyHeadlineWithTopSpace" />
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_HigherThan}" Classes="PreferencesBodyHeadlineLight" VerticalAlignment="Center" />
                            <TextBox x:Name="PlanetOrbitalInclinationMinTextBox" Tag="OrbitalInclinationMin" MaxLength="5" Width="60" TextChanged="PlanetNumberTextBox_TextChanged" />
                            <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_AndLowerThan}" Classes="PreferencesBodyHeadlineLight" VerticalAlignment="Center" />
                            <TextBox x:Name="PlanetOrbitalInclinationMaxTextBox" Tag="OrbitalInclinationMax" MaxLength="5" Width="60" TextChanged="PlanetNumberTextBox_TextChanged" />
                          </StackPanel>
                          <Grid Margin="0,15,0,0" ColumnDefinitions="Auto,7,Auto,*">
                            <TextBlock Grid.Column="0" Text="{x:Static properties:Resources.PreferencesWindow_Label_IsLandable}" Classes="PreferencesBodyHeadline" VerticalAlignment="Center" Margin="0" />
                            <ComboBox x:Name="PlanetLandableComboBox" Grid.Column="2" MinWidth="120" HorizontalAlignment="Left" SelectionChanged="PlanetLandableComboBox_SelectionChanged">
                              <ComboBoxItem Content="{x:Static properties:Resources.PreferencesWindow_Combo_DoesNotMatter}" />
                              <ComboBoxItem Content="{x:Static properties:Resources.PreferencesWindow_Combo_No}" />
                              <ComboBoxItem Content="{x:Static properties:Resources.PreferencesWindow_Combo_Yes}" />
                            </ComboBox>
                          </Grid>
                        </StackPanel>
                        <StackPanel Margin="22,15,17,0">
                          <StackPanel>
                            <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_PlanetClassOneOf}" Classes="PreferencesBodyHeadline" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <TextBox x:Name="PlanetPlanetClassesTextBox" TextWrapping="WrapWithOverflow" MinLines="2" MaxLines="2" Width="212" IsReadOnly="True" />
                              <Button Content="{x:Static properties:Resources.PreferencesWindow_Button_Set}" Tag="PlanetClasses" VerticalAlignment="Top" Click="SelectPlanetStringsButton_Click" />
                            </StackPanel>
                          </StackPanel>
                          <StackPanel Margin="0,15,0,22">
                            <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_StarClassOneOf}" Classes="PreferencesBodyHeadline" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <TextBox x:Name="PlanetStarClassesTextBox" TextWrapping="WrapWithOverflow" MinLines="2" MaxLines="2" Width="212" IsReadOnly="True" />
                              <Button Content="{x:Static properties:Resources.PreferencesWindow_Button_Set}" Tag="StarClasses" VerticalAlignment="Top" Click="SelectPlanetStringsButton_Click" />
                            </StackPanel>
                          </StackPanel>
                        </StackPanel>
                      </StackPanel>
                    </TabItem>
                    <TabItem Header="{x:Static properties:Resources.PreferencesWindow_SubTab_SurfaceConditions}">
                      <StackPanel x:Name="PlanetSurfaceConditionsPanel" Orientation="Horizontal" MinWidth="565" IsEnabled="False">
                        <StackPanel Margin="17,15,0,0">
                          <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_Gravity}" Classes="PreferencesBodyHeadline" />
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_HigherThan}" Classes="PreferencesBodyHeadlineLight" VerticalAlignment="Center" />
                            <TextBox x:Name="PlanetGravityMinTextBox" Tag="GravityMin" MaxLength="5" Width="60" TextChanged="PlanetNumberTextBox_TextChanged" />
                            <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_AndLowerThan}" Classes="PreferencesBodyHeadlineLight" VerticalAlignment="Center" />
                            <TextBox x:Name="PlanetGravityMaxTextBox" Tag="GravityMax" MaxLength="5" Width="60" TextChanged="PlanetNumberTextBox_TextChanged" />
                          </StackPanel>
                          <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_Temperature}" Classes="PreferencesBodyHeadlineWithTopSpace" />
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_HigherThan}" Classes="PreferencesBodyHeadlineLight" VerticalAlignment="Center" />
                            <TextBox x:Name="PlanetTemperatureMinTextBox" Tag="TemperatureMin" MaxLength="5" Width="60" TextChanged="PlanetNumberTextBox_TextChanged" />
                            <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_AndLowerThan}" Classes="PreferencesBodyHeadlineLight" VerticalAlignment="Center" />
                            <TextBox x:Name="PlanetTemperatureMaxTextBox" Tag="TemperatureMax" MaxLength="5" Width="60" TextChanged="PlanetNumberTextBox_TextChanged" />
                          </StackPanel>
                        </StackPanel>
                        <StackPanel Margin="22,15,17,0">
                          <StackPanel>
                            <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_AtmosphereOneOf}" Classes="PreferencesBodyHeadline" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <TextBox x:Name="PlanetAtmospheresTextBox" TextWrapping="WrapWithOverflow" MinLines="2" MaxLines="2" Width="212" IsReadOnly="True" />
                              <Button Content="{x:Static properties:Resources.PreferencesWindow_Button_Set}" Tag="Atmospheres" VerticalAlignment="Top" Click="SelectPlanetStringsButton_Click" />
                            </StackPanel>
                          </StackPanel>
                          <StackPanel Margin="0,15,0,0">
                            <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_VolcanismOneOf}" Classes="PreferencesBodyHeadline" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <TextBox x:Name="PlanetVolcanismsTextBox" TextWrapping="WrapWithOverflow" MinLines="2" MaxLines="2" Width="212" IsReadOnly="True" />
                              <Button Content="{x:Static properties:Resources.PreferencesWindow_Button_Set}" Tag="Volcanisms" VerticalAlignment="Top" Click="SelectPlanetStringsButton_Click" />
                            </StackPanel>
                          </StackPanel>
                        </StackPanel>
                      </StackPanel>
                    </TabItem>
                    <TabItem Header="{x:Static properties:Resources.PreferencesWindow_SubTab_RingRelated}">
                      <StackPanel x:Name="PlanetRingRelatedPanel" Orientation="Horizontal" MinWidth="565" IsEnabled="False">
                        <StackPanel Margin="17,15,0,0">
                          <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_RingsTotalWidth}" Classes="PreferencesBodyHeadline" />
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_HigherThan}" Classes="PreferencesBodyHeadlineLight" VerticalAlignment="Center" />
                            <TextBox x:Name="PlanetRingsTotalWidthMinTextBox" Tag="RingsTotalWidthMin" MaxLength="7" Width="60" TextChanged="PlanetNumberTextBox_TextChanged" />
                            <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_AndLowerThan}" Classes="PreferencesBodyHeadlineLight" VerticalAlignment="Center" />
                            <TextBox x:Name="PlanetRingsTotalWidthMaxTextBox" Tag="RingsTotalWidthMax" MaxLength="7" Width="60" TextChanged="PlanetNumberTextBox_TextChanged" />
                          </StackPanel>
                          <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_RingWidth}" Classes="PreferencesBodyHeadlineWithTopSpace" />
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_HigherThan}" Classes="PreferencesBodyHeadlineLight" VerticalAlignment="Center" />
                            <TextBox x:Name="PlanetRingWidthMinTextBox" Tag="RingWidthMin" MaxLength="7" Width="60" TextChanged="PlanetNumberTextBox_TextChanged" />
                            <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_AndLowerThan}" Classes="PreferencesBodyHeadlineLight" VerticalAlignment="Center" />
                            <TextBox x:Name="PlanetRingWidthMaxTextBox" Tag="RingWidthMax" MaxLength="7" Width="60" TextChanged="PlanetNumberTextBox_TextChanged" />
                          </StackPanel>
                          <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_RingDensity}" Classes="PreferencesBodyHeadlineWithTopSpace" />
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_HigherThan}" Classes="PreferencesBodyHeadlineLight" VerticalAlignment="Center" />
                            <TextBox x:Name="PlanetRingDensityMinTextBox" Tag="RingDensityMin" MaxLength="5" Width="60" TextChanged="PlanetNumberTextBox_TextChanged" />
                            <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_AndLowerThan}" Classes="PreferencesBodyHeadlineLight" VerticalAlignment="Center" />
                            <TextBox x:Name="PlanetRingDensityMaxTextBox" Tag="RingDensityMax" MaxLength="5" Width="60" TextChanged="PlanetNumberTextBox_TextChanged" />
                          </StackPanel>
                        </StackPanel>
                        <StackPanel Margin="22,15,17,0">
                          <StackPanel>
                            <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_RingTypeOneOf}" Classes="PreferencesBodyHeadline" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <TextBox x:Name="PlanetRingTypesTextBox" TextWrapping="WrapWithOverflow" MinLines="2" MaxLines="2" Width="212" IsReadOnly="True" />
                              <Button Content="{x:Static properties:Resources.PreferencesWindow_Button_Set}" Tag="RingTypes" VerticalAlignment="Top" Click="SelectPlanetStringsButton_Click" />
                            </StackPanel>
                          </StackPanel>
                          <StackPanel Margin="0,15,0,22">
                            <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_RingReserveLevelOneOf}" Classes="PreferencesBodyHeadline" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <TextBox x:Name="PlanetRingReserveLevelsTextBox" TextWrapping="WrapWithOverflow" MinLines="2" MaxLines="2" Width="212" IsReadOnly="True" />
                              <Button Content="{x:Static properties:Resources.PreferencesWindow_Button_Set}" Tag="RingReserveLevels" VerticalAlignment="Top" Click="SelectPlanetStringsButton_Click" />
                            </StackPanel>
                          </StackPanel>
                        </StackPanel>
                      </StackPanel>
                    </TabItem>
                    <TabItem Header="{x:Static properties:Resources.PreferencesWindow_SubTab_ParentPlanet}">
                      <StackPanel x:Name="PlanetParentPlanetPanel" Orientation="Horizontal" MinWidth="565" IsEnabled="False">
                        <StackPanel Margin="17,15,0,0">
                          <TextBlock Classes="PreferencesInfoText" Width="500" Text="{x:Static properties:Resources.PreferencesWindow_Tooltip_ParentPlanetCriteria}" />
                          <Grid Margin="0,15,0,0" ColumnDefinitions="Auto,7,Auto,*">
                            <TextBlock Grid.Column="0" Text="{x:Static properties:Resources.PreferencesWindow_Label_CriteriaSetForParentPlanet}" Classes="PreferencesBodyHeadline" VerticalAlignment="Center" Margin="0" />
                            <ComboBox x:Name="ParentPlanetClassificationsComboBox" Grid.Column="2" MinWidth="150" SelectionChanged="ParentPlanetClassificationsComboBox_SelectionChanged" />
                          </Grid>
                        </StackPanel>
                      </StackPanel>
                    </TabItem>
                  </TabControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{x:Static properties:Resources.PreferencesWindow_Tab_Configuration}">
        <ScrollViewer>
          <Border Classes="PreferencesTabContent">
            <StackPanel>
              <StackPanel Classes="PreferencesSection">
                <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_JournalFilesPath}" Classes="PreferencesSectionHeadline" />
                <Border Classes="PreferencesSectionBody">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="EdSavedGamePathTextBox" IsReadOnly="True" Width="600" />
                    <Button x:Name="SetJournalFolderButton" Content="{x:Static properties:Resources.PreferencesWindow_Button_Set}" Click="SetJournalFolderButton_Click" />
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <StackPanel Classes="PreferencesSection">
                  <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_Thresholds}" Classes="PreferencesSectionHeadline" />
                  <Border Classes="PreferencesSectionBody">
                    <StackPanel Orientation="Horizontal" Spacing="17">
                      <StackPanel>
                        <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_ValuableBodies}" Classes="PreferencesBodyHeadline" />
                        <TextBlock Classes="PreferencesInfoText" Width="170" Margin="0,0,0,7" Text="{x:Static properties:Resources.PreferencesWindow_Info_BodyValueThreshold}" />
                        <TextBox x:Name="ValuableBodyThresholdTextBox" MaxLength="7" TextChanged="ValuableBodyThresholdTextBox_TextChanged" />
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_ValuableSpecies}" Classes="PreferencesBodyHeadline" />
                        <TextBlock Classes="PreferencesInfoText" Width="170" Margin="0,0,0,7" Text="{x:Static properties:Resources.PreferencesWindow_Info_SpeciesValueThreshold}" />
                        <TextBox x:Name="ValuableGenusThresholdTextBox" MaxLength="8" TextChanged="ValuableGenusThresholdTextBox_TextChanged" />
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_BiologicalsViewAltitude}" Classes="PreferencesBodyHeadline" />
                        <TextBlock Classes="PreferencesInfoText" Width="170" Margin="0,0,0,7" Text="{x:Static properties:Resources.PreferencesWindow_Info_BiologicalsViewAltitude}" />
                        <TextBox x:Name="BiologicalsViewAltitudeThresholdTextBox" MaxLength="6" TextChanged="BiologicalsViewAltitudeThresholdTextBox_TextChanged" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </StackPanel>
              <StackPanel Classes="PreferencesSection">
                <TextBlock Text="{x:Static properties:Resources.PreferencesWindow_Label_ResetPreferences}" Classes="PreferencesSectionHeadline" />
                <Border Classes="PreferencesSectionBody">
                  <StackPanel>
                    <TextBlock Classes="PreferencesInfoText" Text="{x:Static properties:Resources.PreferencesWindow_ResetWarning}" />
                    <Button x:Name="RestoreDefaultButton" Content="{x:Static properties:Resources.PreferencesWindow_ResetPreferences}" Click="RestoreDefaultButton_Click" HorizontalAlignment="Left" Padding="12,4" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </StackPanel>
          </Border>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Spacing="8">
      <Button x:Name="OkButton" Content="{x:Static properties:Resources.PreferencesWindow_Save}" Padding="16,4" Click="OkButton_Click" />
      <Button x:Name="CancelButton" Content="{x:Static properties:Resources.PreferencesWindow_Cancel}" Padding="16,4" Click="CancelButton_Click" />
    </StackPanel>
  </Grid>
</Window>
