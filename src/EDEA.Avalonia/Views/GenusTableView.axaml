<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EDEA.ViewModels;assembly=EDEA.Core"
             x:Class="EDEA.Avalonia.Views.GenusTableView"
             x:DataType="vm:GenusTableViewModel">
  <Grid>
    <TextBlock Text="{Binding UnknownBiologicalsInfo}" IsVisible="{Binding AreBiologicalsUnknown}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource DimForegroundBrush}"/>
    <ScrollViewer IsVisible="{Binding AreBiologicalsKnown}">
      <ItemsControl ItemsSource="{Binding Genuses}" x:CompileBindings="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:GenusViewModel" x:CompileBindings="False">
            <Grid ColumnDefinitions="200,200,80" Margin="0,2">
              <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource ForegroundBrush}" x:CompileBindings="False"/>
              <TextBlock Grid.Column="1" Text="{Binding SpeciesShort}" Foreground="{StaticResource ForegroundBrush}" x:CompileBindings="False"/>
              <TextBlock Grid.Column="2" Text="{Binding ScanCount}" Foreground="{StaticResource ForegroundBrush}" x:CompileBindings="False"/>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
