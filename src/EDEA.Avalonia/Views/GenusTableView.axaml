<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EDEA.ViewModels;assembly=EDEA.Core"
             x:Class="EDEA.Avalonia.Views.GenusTableView"
             x:DataType="vm:GenusTableViewModel">
  <Grid>
    <TextBlock Text="{Binding UnknownBiologicalsInfo}" IsVisible="{Binding AreBiologicalsUnknown}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource DimForegroundBrush}"/>
    <ScrollViewer IsVisible="{Binding AreBiologicalsKnown}">
      <Grid RowDefinitions="Auto,*" Margin="4" x:CompileBindings="False" IsSharedSizeScope="True">
        <Grid Grid.Row="0" Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="GenusName" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="GenusSpecies" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="GenusScan" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Genus" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" x:CompileBindings="False"/>
          <TextBlock Grid.Column="1" Text="Species" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" x:CompileBindings="False"/>
          <TextBlock Grid.Column="2" Text="Scans" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" x:CompileBindings="False"/>
        </Grid>
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Genuses}" x:CompileBindings="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:GenusViewModel" x:CompileBindings="False">
              <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" SharedSizeGroup="GenusName" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="GenusSpecies" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="GenusScan" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource ForegroundBrush}" Margin="0,0,8,0" x:CompileBindings="False"/>
                <TextBlock Grid.Column="1" Text="{Binding SpeciesShort}" Foreground="{StaticResource ForegroundBrush}" Margin="0,0,8,0" x:CompileBindings="False"/>
                <TextBlock Grid.Column="2" Text="{Binding ScanCount}" Foreground="{StaticResource ForegroundBrush}" x:CompileBindings="False"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
