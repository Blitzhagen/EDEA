<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EDEA.ViewModels;assembly=EDEA.Core"
             xmlns:properties="using:EDEA.Properties"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:edea="using:EDEA"
             x:Class="EDEA.Avalonia.Views.GenusHudTableView"
             x:DataType="vm:GenusTableViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.InfoBanner">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,50,30,0" />
      <Setter Property="Foreground" Value="{DynamicResource MainColor}" />
      <Setter Property="FontSize" Value="{DynamicResource HeaderFontSize}" />
    </Style>
    <Style Selector="TextBlock.DataGridHeadline">
      <Setter Property="Margin" Value="11,30,0,3" />
      <Setter Property="Foreground" Value="{DynamicResource HighlightGrey}" />
      <Setter Property="FontSize" Value="{DynamicResource HeaderFontSize}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="DataGrid.Predicted">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Margin" Value="6,0,0,0" />
    </Style>
    <Style Selector="DataGrid.Predicted DataGridRow">
      <Setter Property="Background" Value="{DynamicResource InverseCellColor}" />
    </Style>
    <Style Selector="DataGrid.Predicted DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="{DynamicResource InverseCellHighlightColor}" />
    </Style>
    <Style Selector="DataGrid.Predicted DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="{DynamicResource InverseCellHighlightColor}" />
    </Style>
    <Style Selector="DataGrid.Predicted DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource HighlightGrey}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto,*">
    <TextBlock Grid.Row="0"
               Text="{Binding UnknownBiologicalsInfo}"
               IsVisible="{Binding AreBiologicalsUnknown}"
               Classes="InfoBanner" />

    <DataGrid Grid.Row="0"
              Grid.RowSpan="2"
              x:Name="GenusDataGrid" HeadersVisibility="None"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              IsVisible="{Binding AreBiologicalsKnown}"
              ItemsSource="{Binding Genuses}"
              ScrollViewer.HorizontalScrollBarVisibility="Hidden"
              GridLinesVisibility="Horizontal">
      <DataGrid.Columns>
        <DataGridTextColumn CanUserSort="True" SortMemberPath="Name" Header="{x:Static properties:Resources.ColumnHeaderName}" Binding="{Binding Name}" />
        <DataGridTextColumn CanUserSort="True" SortMemberPath="SpeciesShort" Header="{x:Static properties:Resources.ColumnHeaderSpecies}" Binding="{Binding SpeciesShort}" IsVisible="{Binding GenusColumnSpeciesVisible, Source={x:Static edea:Preferences.HudWindow}}" />
        <DataGridTextColumn CanUserSort="True" SortMemberPath="VariantShort" Header="{x:Static properties:Resources.ColumnHeaderVariant}" Binding="{Binding VariantShort}" IsVisible="{Binding GenusColumnVariantVisible, Source={x:Static edea:Preferences.HudWindow}}" />

        <DataGridTemplateColumn CanUserSort="True" SortMemberPath="AnalysisComplete" IsVisible="{Binding GenusColumnAnalysisCompleteIconVisible, Source={x:Static edea:Preferences.HudWindow}}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:GenusViewModel">
              <materialIcons:MaterialIcon Kind="Check" IsVisible="{Binding AnalysisComplete}" Foreground="{DynamicResource MainColor}" Width="16" Height="16" ToolTip.Tip="{x:Static properties:Resources.TooltipAnalysisCompleteIcon}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTextColumn CanUserSort="True" SortMemberPath="ScanCount" Header="{x:Static properties:Resources.ColumnHeaderScans}" Binding="{Binding ScanCount}" IsVisible="{Binding GenusColumnScansVisible, Source={x:Static edea:Preferences.HudWindow}}" />

        <DataGridTemplateColumn CanUserSort="True" SortMemberPath="ClonalColonyRangeSort" Header="{x:Static properties:Resources.ColumnHeaderClonalColonyRange}" IsVisible="{Binding GenusColumnClonalColonyRangeVisible, Source={x:Static edea:Preferences.HudWindow}}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:GenusViewModel">
              <TextBlock Text="{Binding ClonalColonyRange}" Foreground="{DynamicResource MainColor}" HorizontalAlignment="Right" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn CanUserSort="True" SortMemberPath="CurrentDistanceToLocationAt1stScanSort" Header="{x:Static properties:Resources.ColumnHeader1stScanDistance}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:GenusViewModel">
              <Border HorizontalAlignment="Right" CornerRadius="7" Padding="4,0" IsVisible="{Binding CurrentDistanceToLocationAt1stScanAvailable}" Background="{Binding Is1stScanOutOfClonalColonyRange, Converter={StaticResource BoolToResourceBrushConverter}, ConverterParameter='OutOfClonalColonyRangeColor;InClonalColonyRangeColor;Transparent'}">
                <TextBlock Text="{Binding CurrentDistanceToLocationAt1stScan}" Foreground="{DynamicResource MainCellColor}" HorizontalAlignment="Right" />
              </Border>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn CanUserSort="True" SortMemberPath="CurrentDistanceToLocationAt2ndScanSort" Header="{x:Static properties:Resources.ColumnHeader2ndScanDistance}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:GenusViewModel">
              <Border HorizontalAlignment="Right" CornerRadius="7" Padding="4,0" IsVisible="{Binding CurrentDistanceToLocationAt2ndScanAvailable}" Background="{Binding Is2ndScanOutOfClonalColonyRange, Converter={StaticResource BoolToResourceBrushConverter}, ConverterParameter='OutOfClonalColonyRangeColor;InClonalColonyRangeColor;Transparent'}">
                <TextBlock Text="{Binding CurrentDistanceToLocationAt2ndScan}" Foreground="{DynamicResource MainCellColor}" HorizontalAlignment="Right" />
              </Border>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn CanUserSort="True" SortMemberPath="VistaGenomicsValueSort" Header="{x:Static properties:Resources.ColumnHeaderVistaGenomicsValue}" IsVisible="{Binding GenusColumnVistaGenomicsValueVisible, Source={x:Static edea:Preferences.HudWindow}}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:GenusViewModel">
              <Grid HorizontalAlignment="Right" IsVisible="{Binding SpeciesSet}">
                <ToolTip.Tip>
                  <ContentControl ContentTemplate="{StaticResource GenusVistaGenomicsValueTooltipTemplate}" />
                </ToolTip.Tip>
                <TextBlock Text="{Binding VistaGenomicsMaxValue}" Foreground="{Binding AnalysisNotComplete, Converter={StaticResource BoolToResourceBrushConverter}, ConverterParameter='HighlightGrey;MainColor'}" HorizontalAlignment="Right" />
              </Grid>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn CanUserSort="True" SortMemberPath="IsValuableGenus" IsVisible="{Binding GenusColumnValuableIconVisible, Source={x:Static edea:Preferences.HudWindow}}">
          <DataGridTemplateColumn.Header>
            <Border Background="Transparent" Padding="4" ToolTip.ShowDelay="100" ToolTip.Tip="{x:Static properties:Resources.TooltipValuableGenusIcon}"><materialIcons:MaterialIcon Kind="DiamondStone" Width="16" Height="16" Foreground="{DynamicResource MainBackgroundColor}"  /></Border>
          </DataGridTemplateColumn.Header>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:GenusViewModel">
              <materialIcons:MaterialIcon Kind="DiamondStone" IsVisible="{Binding IsValuableGenus}" Foreground="{Binding AnalysisComplete, Converter={StaticResource BoolToResourceBrushConverter}, ConverterParameter='MainColor;ValuableIconColor'}" Width="16" Height="16" ToolTip.Tip="{x:Static properties:Resources.TooltipValuableGenusIcon}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn CanUserSort="True" SortMemberPath="IsFirstDiscoveryAndSpeciesSet" IsVisible="{Binding GenusColumnNewIconVisible, Source={x:Static edea:Preferences.HudWindow}}">
          <DataGridTemplateColumn.Header>
            <Border Background="Transparent" Padding="4" ToolTip.ShowDelay="100" ToolTip.Tip="{x:Static properties:Resources.TooltipGenusIsFirstDiscovery}"><materialIcons:MaterialIcon Kind="PlusCircle" Width="16" Height="16" Foreground="{DynamicResource MainBackgroundColor}"  /></Border>
          </DataGridTemplateColumn.Header>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:GenusViewModel">
              <materialIcons:MaterialIcon Kind="PlusCircle" IsVisible="{Binding IsFirstDiscoveryAndSpeciesSet}" Foreground="{Binding AnalysisComplete, Converter={StaticResource BoolToResourceBrushConverter}, ConverterParameter='NewIconColor;HighlightGrey'}" Width="16" Height="16" ToolTip.Tip="{x:Static properties:Resources.TooltipGenusIsFirstDiscovery}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <TextBlock Grid.Row="2"
               Text="{x:Static properties:Resources.GenusTable_PossibleOccurrences}"
               IsVisible="{Binding PredictedSpeciesAvailable}"
               Classes="DataGridHeadline" />

    <DataGrid Grid.Row="3"
              x:Name="PredictedSpeciesDataGrid" HeadersVisibility="None"
              Classes="Predicted"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              IsVisible="{Binding PredictedSpeciesAvailable}"
              ItemsSource="{Binding PredictedSpecies}"
              ScrollViewer.HorizontalScrollBarVisibility="Hidden"
              GridLinesVisibility="Horizontal">
      <DataGrid.Columns>
        <DataGridTextColumn CanUserSort="True" SortMemberPath="Name" Header="{x:Static properties:Resources.ColumnHeaderName}" Binding="{Binding Name}" />
        <DataGridTextColumn CanUserSort="True" SortMemberPath="SpeciesShort" Header="{x:Static properties:Resources.ColumnHeaderSpecies}" Binding="{Binding SpeciesShort}" IsVisible="{Binding GenusColumnSpeciesVisible, Source={x:Static edea:Preferences.HudWindow}}" />

        <DataGridTemplateColumn CanUserSort="True" SortMemberPath="ClonalColonyRangeSort" Header="{x:Static properties:Resources.ColumnHeaderClonalColonyRange}" IsVisible="{Binding GenusColumnClonalColonyRangeVisible, Source={x:Static edea:Preferences.HudWindow}}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:GenusClassificationViewModel">
              <TextBlock Text="{Binding ClonalColonyRange}" Foreground="{DynamicResource HighlightGrey}" HorizontalAlignment="Right" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn CanUserSort="True" SortMemberPath="VistaGenomicsMaxValueSort" Header="{x:Static properties:Resources.ColumnHeaderVistaGenomicsValue}" IsVisible="{Binding GenusColumnVistaGenomicsValueVisible, Source={x:Static edea:Preferences.HudWindow}}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:GenusClassificationViewModel">
              <Grid HorizontalAlignment="Right">
                <ToolTip.Tip>
                  <ContentControl ContentTemplate="{StaticResource GenusClassificationVistaGenomicsValueTooltipTemplate}" />
                </ToolTip.Tip>
                <TextBlock Text="{Binding VistaGenomicsMaxValue}" Foreground="{DynamicResource HighlightGrey}" HorizontalAlignment="Right" />
              </Grid>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn CanUserSort="True" SortMemberPath="IsValuable" IsVisible="{Binding GenusColumnValuableIconVisible, Source={x:Static edea:Preferences.HudWindow}}">
          <DataGridTemplateColumn.Header>
            <Border Background="Transparent" Padding="4" ToolTip.ShowDelay="100" ToolTip.Tip="{x:Static properties:Resources.TooltipValuableGenusPredictedIcon}"><materialIcons:MaterialIcon Kind="DiamondStone" Width="16" Height="16" Foreground="{DynamicResource MainBackgroundColor}"  /></Border>
          </DataGridTemplateColumn.Header>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:GenusClassificationViewModel">
              <materialIcons:MaterialIcon Kind="DiamondStone" IsVisible="{Binding IsValuable}" Foreground="{DynamicResource HighlightGrey}" Width="16" Height="16" ToolTip.Tip="{x:Static properties:Resources.TooltipValuableGenusPredictedIcon}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn CanUserSort="True" SortMemberPath="IsFirstDiscovery" IsVisible="{Binding GenusColumnNewIconVisible, Source={x:Static edea:Preferences.HudWindow}}">
          <DataGridTemplateColumn.Header>
            <Border Background="Transparent" Padding="4" ToolTip.ShowDelay="100" ToolTip.Tip="{x:Static properties:Resources.TooltipGenusIsFirstDiscovery}"><materialIcons:MaterialIcon Kind="PlusCircle" Width="16" Height="16" Foreground="{DynamicResource MainBackgroundColor}"  /></Border>
          </DataGridTemplateColumn.Header>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:GenusClassificationViewModel">
              <materialIcons:MaterialIcon Kind="PlusCircle" IsVisible="{Binding IsFirstDiscovery}" Foreground="{DynamicResource HighlightGrey}" Width="16" Height="16" ToolTip.Tip="{x:Static properties:Resources.TooltipGenusIsFirstDiscovery}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
