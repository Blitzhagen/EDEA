<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EDEA.ViewModels;assembly=EDEA.Core"
             x:Class="EDEA.Avalonia.Views.BodyGeologicalsTooltip"
             x:DataType="vm:BodyViewModel">

  <Border Background="{DynamicResource MainBackgroundColor}" Padding="4">
    <StackPanel>
    <TextBlock Foreground="{DynamicResource GeologicalsIconColor}">
      <TextBlock.Text>
        <MultiBinding StringFormat="{}{0} geologische Signale gefunden. {1}.">
          <Binding Path="GeologicalsCount" />
          <Binding Path="Volcanism" />
        </MultiBinding>
      </TextBlock.Text>
    </TextBlock>
  </StackPanel>
  </Border>
</UserControl>
