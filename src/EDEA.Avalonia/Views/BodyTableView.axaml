<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EDEA.ViewModels;assembly=EDEA.Core"
             x:Class="EDEA.Avalonia.Views.BodyTableView"
             x:DataType="vm:BodyTableViewModel">
  <Grid>
    <TextBlock Text="{Binding NoBodiesInfo}" IsVisible="{Binding AreNoBodiesAvailable}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource DimForegroundBrush}"/>
    <ScrollViewer IsVisible="{Binding AreNoBodiesAvailable, Converter={StaticResource InverseBoolConverter}}">
      <ItemsControl ItemsSource="{Binding Bodies}" x:CompileBindings="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:BodyViewModel" x:CompileBindings="False">
            <Grid ColumnDefinitions="120,120,120,120" Margin="0,2">
              <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource ForegroundBrush}" x:CompileBindings="False"/>
              <TextBlock Grid.Column="1" Text="{Binding TypeHumanReadable}" Foreground="{StaticResource ForegroundBrush}" x:CompileBindings="False"/>
              <TextBlock Grid.Column="2" Text="{Binding Atmosphere}" Foreground="{StaticResource ForegroundBrush}" x:CompileBindings="False"/>
              <TextBlock Grid.Column="3" Text="{Binding SurfaceTemperature}" Foreground="{StaticResource ForegroundBrush}" x:CompileBindings="False"/>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
