<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EDEA.ViewModels;assembly=EDEA.Core"
             xmlns:properties="using:EDEA.Properties"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:views="clr-namespace:EDEA.Avalonia.Views"
             x:Class="EDEA.Avalonia.Views.SurroundingsTableView"
             x:DataType="vm:SurroundingsTableViewModel">
  <Grid>
    <TextBlock Text="{Binding NoSurroundingsInfo}"
               IsVisible="{Binding ShowNoSurroundingsInfo}"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"
               Foreground="{DynamicResource DimForegroundBrush}"
               ZIndex="2" />
    <TextBlock Text="{Binding SurroundingsLoadingInfo}"
               IsVisible="{Binding ShowSurroundingsLoadingInfo}"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"
               Foreground="{DynamicResource AccentBrush}"
               ZIndex="1" />
    <DataGrid Name="SurroundingsDataGrid"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              ItemsSource="{Binding SurroundingStarSystems}"
              GridLinesVisibility="Horizontal"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              ScrollViewer.HorizontalScrollBarVisibility="Hidden"
              CanUserReorderColumns="True"
              CanUserResizeColumns="True">
      <DataGrid.Columns>
        <DataGridTemplateColumn CanUserSort="True" SortMemberPath="Name" Header="{x:Static properties:Resources.ColumnHeaderSystemName}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:StarSystemViewModel">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <materialIcons:MaterialIcon Grid.Column="0" Kind="Globe" IsVisible="{Binding WasReadFromEdsmOnly}" Foreground="{DynamicResource EdsmIconColor}" Width="16" Height="16" Margin="0,0,4,0" ToolTip.Tip="EDSM" />
                <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="{DynamicResource MainColor}" />
              </Grid>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn CanUserSort="True" SortMemberPath="StarClass" Header="{x:Static properties:Resources.ColumnHeaderStarClass}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:StarSystemViewModel">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <materialIcons:MaterialIcon Grid.Column="0" Kind="Fuel" IsVisible="{Binding PrimaryStarIsScoopable}" Foreground="{DynamicResource ScoopableIconColor}" Width="16" Height="16" Margin="0,0,4,0" ToolTip.Tip="Scoopable" />
                <TextBlock Grid.Column="1" Text="{Binding StarClass}" Foreground="{DynamicResource MainColor}" />
              </Grid>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn CanUserSort="True" SortMemberPath="ExplorationStatus" Header="{x:Static properties:Resources.ColumnHeaderDiscoveryStatus}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:StarSystemViewModel">
              <TextBlock Text="{Binding ExplorationStatus}" Foreground="{DynamicResource MainColor}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTextColumn CanUserSort="True" SortMemberPath="BodiesCartographicMaxValueSort" Header="{x:Static properties:Resources.ColumnHeaderCartographicValue}" Binding="{Binding BodiesCartographicMaxValue}" />
        <DataGridTextColumn CanUserSort="True" SortMemberPath="ExplorationValueSort" Header="{x:Static properties:Resources.ColumnHeaderOverallProgress}" Binding="{Binding OverallProgress}" />

        <DataGridTemplateColumn CanUserSort="True" SortMemberPath="MatchingPlanetClassificationsSort">
          <DataGridTemplateColumn.Header>
            <Border Background="Transparent" Padding="4" ToolTip.ShowDelay="100" ToolTip.Tip="{x:Static properties:Resources.TooltipPlanetOfInterestIcon}"><materialIcons:MaterialIcon Kind="StarCircle" Width="16" Height="16" Foreground="{DynamicResource MainBackgroundColor}"  /></Border>
          </DataGridTemplateColumn.Header>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:StarSystemViewModel">
              <Grid HorizontalAlignment="Stretch" IsVisible="{Binding HasMatchingPlanetClassifications}" Background="Transparent" ToolTip.ShowDelay="100">
                <ToolTip.Tip>
                  <ContentControl ContentTemplate="{StaticResource StarSystemPlanetOfInterestTooltipTemplate}" />
                </ToolTip.Tip>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" ColumnDefinitions="Auto,Auto">
                  <materialIcons:MaterialIcon Grid.Column="0" Kind="StarCircle" Foreground="{DynamicResource PlanetOfInterestIconColor}" Width="16" Height="16" />
                  <TextBlock Grid.Column="1" Text="{Binding MatchingPlanetClassificationsCount}" Foreground="{DynamicResource PlanetOfInterestIconColor}" Margin="2,0,0,0" />
                </Grid>
              </Grid>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn CanUserSort="True" SortMemberPath="ValuableBodiesSort">
          <DataGridTemplateColumn.Header>
            <Border Background="Transparent" Padding="4" ToolTip.ShowDelay="100" ToolTip.Tip="{x:Static properties:Resources.TooltipValuableBodyIcon}"><materialIcons:MaterialIcon Kind="DiamondStone" Width="16" Height="16" Foreground="{DynamicResource MainBackgroundColor}"  /></Border>
          </DataGridTemplateColumn.Header>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:StarSystemViewModel">
              <Grid HorizontalAlignment="Stretch" IsVisible="{Binding HasValuableBodies}" Background="Transparent" ToolTip.ShowDelay="100" ToolTip.Tip="{x:Static properties:Resources.TooltipValuableBodyIcon}">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" ColumnDefinitions="Auto,Auto">
                  <materialIcons:MaterialIcon Grid.Column="0" Kind="DiamondStone" Foreground="{Binding AllValuableBodiesSurfaceScanned, Converter={StaticResource BoolToResourceBrushConverter}, ConverterParameter='CompleteIconColor;ValuableIconColor'}" Width="16" Height="16" />
                  <TextBlock Grid.Column="1" Text="{Binding ValuableBodiesCount}" Foreground="{Binding AllValuableBodiesSurfaceScanned, Converter={StaticResource BoolToResourceBrushConverter}, ConverterParameter='CompleteIconColor;ValuableIconColor'}" Margin="2,0,0,0" />
                </Grid>
              </Grid>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn CanUserSort="True" SortMemberPath="ExploredTerraformablesSort">
          <DataGridTemplateColumn.Header>
            <Border Background="Transparent" Padding="4" ToolTip.ShowDelay="100" ToolTip.Tip="{x:Static properties:Resources.TooltipTerraformableIcon}"><materialIcons:MaterialIcon Kind="Terraform" Width="16" Height="16" Foreground="{DynamicResource MainBackgroundColor}"  /></Border>
          </DataGridTemplateColumn.Header>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:StarSystemViewModel">
              <Grid HorizontalAlignment="Center" IsVisible="{Binding HasExploredTerraformables}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <materialIcons:MaterialIcon Grid.Column="0" Kind="Terraform" Foreground="{DynamicResource TerraformableIconColor}" Width="16" Height="16" ToolTip.Tip="{x:Static properties:Resources.TooltipTerraformableIcon}" />
                <TextBlock Grid.Column="1" Text="{Binding ExploredTerraformablesCount}" Foreground="{DynamicResource TerraformableIconColor}" Margin="2,0,0,0" />
              </Grid>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn CanUserSort="True" SortMemberPath="ExploredLandablesSort">
          <DataGridTemplateColumn.Header>
            <Border Background="Transparent" Padding="4" ToolTip.ShowDelay="100" ToolTip.Tip="{x:Static properties:Resources.TooltipLandableIcon}"><materialIcons:MaterialIcon Kind="AirplaneLanding" Width="16" Height="16" Foreground="{DynamicResource MainBackgroundColor}"  /></Border>
          </DataGridTemplateColumn.Header>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:StarSystemViewModel">
              <Grid HorizontalAlignment="Center" IsVisible="{Binding HasExploredLandables}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <materialIcons:MaterialIcon Grid.Column="0" Kind="AirplaneLanding" Foreground="{DynamicResource LandableIconColor}" Width="16" Height="16" ToolTip.Tip="{x:Static properties:Resources.TooltipLandableIcon}" />
                <TextBlock Grid.Column="1" Text="{Binding ExploredLandablesCount}" Foreground="{DynamicResource LandableIconColor}" Margin="2,0,0,0" />
              </Grid>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn CanUserSort="True" SortMemberPath="PopulationSort">
          <DataGridTemplateColumn.Header>
            <Border Background="Transparent" Padding="4" ToolTip.ShowDelay="100" ToolTip.Tip="{x:Static properties:Resources.TooltipPopulatedIcon}"><materialIcons:MaterialIcon Kind="AccountGroup" Width="16" Height="16" Foreground="{DynamicResource MainBackgroundColor}"  /></Border>
          </DataGridTemplateColumn.Header>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:StarSystemViewModel">
              <Grid HorizontalAlignment="Center" IsVisible="{Binding HasPopulation}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <materialIcons:MaterialIcon Grid.Column="0" Kind="AccountGroup" Foreground="{DynamicResource PopulatedIconColor}" Width="16" Height="16" ToolTip.Tip="{x:Static properties:Resources.TooltipPopulatedIcon}" />
                <TextBlock Grid.Column="1" Text="{Binding Population}" Foreground="{DynamicResource PopulatedIconColor}" Margin="2,0,0,0" />
              </Grid>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTextColumn CanUserSort="True" SortMemberPath="EdsmDiscoveryCommander" Header="{x:Static properties:Resources.ColumnHeaderEdsmDiscoverer}" Binding="{Binding EdsmDiscoveryCommander}" />

        <DataGridTextColumn CanUserSort="True" SortMemberPath="JumpDistanceLySort" Header="{x:Static properties:Resources.ColumnHeaderDistance}" Binding="{Binding JumpDistanceLy}" />
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>