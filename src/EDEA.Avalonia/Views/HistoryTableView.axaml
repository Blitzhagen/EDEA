<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EDEA.ViewModels;assembly=EDEA.Core"
             xmlns:properties="using:EDEA.Properties"
             x:Class="EDEA.Avalonia.Views.HistoryTableView"
             x:DataType="vm:HistoryViewModel">

  <UserControl.Styles>
    <Style Selector="Border.HistoryGroup">
      <Setter Property="Background" Value="{DynamicResource CellHighlightColor}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MainCellColor}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="0,9,10,0" />
      <Setter Property="Margin" Value="0,0,0,24" />
    </Style>
    <Style Selector="Border.HistoryPanel">
      <Setter Property="Background" Value="{DynamicResource MainCellColor}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="0,2,0,6" />
      <Setter Property="Margin" Value="10,0,0,10" />
      <Setter Property="MinWidth" Value="90" />
    </Style>
    <Style Selector="TextBlock.HistoryHeadline">
      <Setter Property="Foreground" Value="{DynamicResource MainColor}" />
      <Setter Property="FontSize" Value="{DynamicResource HistoryTotalValueFontSize}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style Selector="TextBlock.HistoryGroupHeadline">
      <Setter Property="Foreground" Value="{DynamicResource MainColor}" />
      <Setter Property="FontSize" Value="{DynamicResource HeaderFontSize}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="TextBlock.HistoryPanelHeadline">
      <Setter Property="Foreground" Value="{DynamicResource MainColor}" />
      <Setter Property="Padding" Value="10,4,10,2" />
      <Setter Property="FontSize" Value="{DynamicResource MainFontSize}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.HistoryPanelValue">
      <Setter Property="Padding" Value="12,0,12,0" />
      <Setter Property="Foreground" Value="{DynamicResource HighlightColor}" />
      <Setter Property="FontSize" Value="{DynamicResource HistoryFontSize}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                Background="{DynamicResource MainBackgroundColor}">
    <StackPanel Margin="20" Spacing="20" HorizontalAlignment="Center">

      <TextBlock Text="{x:Static properties:Resources.History_Headline_CurrentExplorationTrip}"
                 Classes="HistoryHeadline" />

      <Border Classes="HistoryGroup">
        <StackPanel>
          <TextBlock Text="{x:Static properties:Resources.History_Group_EstimatedTotalValueOfExplorationData}"
                     Classes="HistoryGroupHeadline" />
          <Border Classes="HistoryPanel" MinWidth="160">
            <TextBlock Text="{Binding HistoryData.TripTotalExplorationDataValueSum}"
                       FontSize="{DynamicResource HeaderFontSize}"
                       Classes="HistoryPanelValue" />
          </Border>
        </StackPanel>
      </Border>

      <Border Classes="HistoryGroup">
        <StackPanel>
          <TextBlock Text="{x:Static properties:Resources.History_Group_EstimatedCartographicValues}"
                     Classes="HistoryGroupHeadline" />
          <StackPanel Orientation="Horizontal">
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_Base}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.TripBodyCartographicBaseValueSum}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_SurfaceScan}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.TripBodyCartographicSurfaceScanValueSum}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_Bonuses}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.TripBodyCartographicBonusValueSum}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="HistoryGroup">
        <StackPanel>
          <TextBlock Text="{x:Static properties:Resources.History_Group_EstimatedVistaGenomicsValues}"
                     Classes="HistoryGroupHeadline" />
          <StackPanel Orientation="Horizontal">
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_Base}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.TripGenusVistaGenomicsBaseValueSum}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_FirstDiscoveryBonus}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.TripGenusVistaGenomicsFirstDiscoveryBonusValueSum}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="HistoryGroup">
        <StackPanel>
          <TextBlock Text="{x:Static properties:Resources.History_Group_Systems}"
                     Classes="HistoryGroupHeadline" />
          <StackPanel Orientation="Horizontal">
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_Discovered}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.TripSystemCount}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_FirstDiscovery}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.TripSystemFirstDiscoveryCount}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_MostFrequent}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.TripSystemMostFrequentStarClass}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_Rarest}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.TripSystemRarestStarClass}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="HistoryGroup">
        <StackPanel>
          <TextBlock Text="{x:Static properties:Resources.History_Group_Bodies}"
                     Classes="HistoryGroupHeadline" />
          <StackPanel Orientation="Horizontal">
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_Signals}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.TripBodySignalSum}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_Discovered}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.TripBodyCount}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_FirstDiscovery}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.TripBodyFirstDiscoveryCount}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_Mapped}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.TripBodySurfaceScanCount}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_Terraformable}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.TripBodyTerraformableCount}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_WithTouchdowns}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.TripBodyTouchdownCount}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_Valuable}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.TripBodyValuableCount}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_WithRings}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.TripBodyRingBodyCount}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="HistoryGroup">
        <StackPanel>
          <TextBlock Text="{x:Static properties:Resources.History_Group_Rings}"
                     Classes="HistoryGroupHeadline" />
          <StackPanel Orientation="Horizontal">
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_Discovered}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.TripRingCount}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_FirstDiscovery}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.TripRingFirstDiscoveryCount}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_MostFrequent}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.TripRingMostFrequentType}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_Rarest}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.TripRingRarestType}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="HistoryGroup">
        <StackPanel>
          <TextBlock Text="{x:Static properties:Resources.History_Group_Biologicals}"
                     Classes="HistoryGroupHeadline" />
          <StackPanel Orientation="Horizontal">
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_Signals}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.TripGenusSignalSum}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_Discovered}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.TripGenusCount}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_FirstDiscovery}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.TripGenusFirstDiscoveryCount}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_Analysed}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.TripGenusAnalysisCompleteCount}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_MostFrequentAnalysed}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.TripGenusMostFrequentSpecies}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_RarestAnalysed}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.TripGenusRarestSpecies}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </Border>

      <Rectangle HorizontalAlignment="Stretch" Fill="{DynamicResource MainColor}" Height="1" Margin="0,10" />

      <TextBlock Text="{x:Static properties:Resources.History_Headline_EntireExplorationHistory}"
                 Classes="HistoryHeadline" />

      <Border Classes="HistoryGroup">
        <StackPanel>
          <TextBlock Text="{x:Static properties:Resources.History_Group_EstimatedTotalValueOfExplorationData}"
                     Classes="HistoryGroupHeadline" />
          <Border Classes="HistoryPanel" MinWidth="160">
            <TextBlock Text="{Binding HistoryData.TotalExplorationDataValueSum}"
                       FontSize="{DynamicResource HeaderFontSize}"
                       Classes="HistoryPanelValue" />
          </Border>
        </StackPanel>
      </Border>

      <Border Classes="HistoryGroup">
        <StackPanel>
          <TextBlock Text="{x:Static properties:Resources.History_Group_EstimatedCartographicValues}"
                     Classes="HistoryGroupHeadline" />
          <StackPanel Orientation="Horizontal">
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_Base}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.BodyCartographicBaseValueSum}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_SurfaceScan}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.BodyCartographicSurfaceScanValueSum}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_Bonuses}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.BodyCartographicBonusValueSum}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="HistoryGroup">
        <StackPanel>
          <TextBlock Text="{x:Static properties:Resources.History_Group_EstimatedVistaGenomicsValues}"
                     Classes="HistoryGroupHeadline" />
          <StackPanel Orientation="Horizontal">
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_Base}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.GenusVistaGenomicsBaseValueSum}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_FirstDiscoveryBonus}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.GenusVistaGenomicsFirstDiscoveryBonusValueSum}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="HistoryGroup">
        <StackPanel>
          <TextBlock Text="{x:Static properties:Resources.History_Group_Systems}"
                     Classes="HistoryGroupHeadline" />
          <StackPanel Orientation="Horizontal">
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_Discovered}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.SystemCount}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_FirstDiscovery}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.SystemFirstDiscoveryCount}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_MostFrequent}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.SystemMostFrequentStarClass}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_Rarest}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.SystemRarestStarClass}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="HistoryGroup">
        <StackPanel>
          <TextBlock Text="{x:Static properties:Resources.History_Group_Bodies}"
                     Classes="HistoryGroupHeadline" />
          <StackPanel Orientation="Horizontal">
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_Signals}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.BodySignalSum}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_Discovered}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.BodyCount}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_FirstDiscovery}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.BodyFirstDiscoveryCount}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_Mapped}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.BodySurfaceScanCount}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_Terraformable}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.BodyTerraformableCount}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_WithTouchdowns}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.BodyTouchdownCount}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_Valuable}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.BodyValuableCount}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_WithRings}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.BodyRingBodyCount}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="HistoryGroup">
        <StackPanel>
          <TextBlock Text="{x:Static properties:Resources.History_Group_Rings}"
                     Classes="HistoryGroupHeadline" />
          <StackPanel Orientation="Horizontal">
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_Discovered}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.RingCount}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_FirstDiscovery}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.RingFirstDiscoveryCount}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_MostFrequent}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.RingMostFrequentType}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_Rarest}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.RingRarestType}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="HistoryGroup">
        <StackPanel>
          <TextBlock Text="{x:Static properties:Resources.History_Group_Biologicals}"
                     Classes="HistoryGroupHeadline" />
          <StackPanel Orientation="Horizontal">
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_Signals}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.GenusSignalSum}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_Discovered}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.GenusCount}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_FirstDiscovery}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.GenusFirstDiscoveryCount}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_Analysed}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.GenusAnalysisCompleteCount}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_MostFrequentAnalysed}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.GenusMostFrequentSpecies}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
            <Border Classes="HistoryPanel">
              <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.History_Panel_RarestAnalysed}"
                           Classes="HistoryPanelHeadline" />
                <TextBlock Text="{Binding HistoryData.GenusRarestSpecies}"
                           Classes="HistoryPanelValue" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>