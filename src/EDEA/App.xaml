<Application x:Class="EDEA.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:EDEA.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
                <ResourceDictionary Source="Resources/Icons.xaml"/>
                <ResourceDictionary Source="Resources/Templates.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:BooleanToBrushConverter x:Key="BooleanToBrushConverter" TrueBrush="#00FF00" FalseBrush="#555555"/>
            <converters:BooleanToSymbolConverter x:Key="BooleanToSymbolConverter"/>
            <converters:IntEqualsConverter x:Key="IntEqualsConverter"/>
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>

            <SolidColorBrush x:Key="BackgroundBrush" Color="#1A0F05"/>
            <SolidColorBrush x:Key="PanelBrush" Color="#2A1A0A"/>
            <SolidColorBrush x:Key="CardBrush" Color="#331E0C"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#FF6A00"/>
            <SolidColorBrush x:Key="ForegroundBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="DimForegroundBrush" Color="#AAAAAA"/>
            <SolidColorBrush x:Key="BorderBrush" Color="#FF6A00"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
