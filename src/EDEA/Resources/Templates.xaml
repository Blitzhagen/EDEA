<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converter="clr-namespace:EDEA.Converters" xmlns:mns="clr-namespace:EDEA" xmlns:i="http://schemas.microsoft.com/xaml/behaviors" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:properties="clr-namespace:EDEA.Properties">
  <DataTemplate x:Key="ExplorationBubbleInTooltipTemplate">
    <Grid Column="1" Row="0" HorizontalAlignment="Right">
      <Rectangle Width="{Binding Width, ElementName=ExplorationStatusTextBlock}" Height="{Binding Height, ElementName=ExplorationStatusTextBlock}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource TooltipExplorationStatusBubble}" TargetType="{x:Type Rectangle}">
            <Setter Property="Fill" Value="{Binding Path=., Converter={StaticResource SystemExplorationStatusToBrushColorConverter}}" />
          </Style>
        </FrameworkElement.Style>
      </Rectangle>
      <TextBlock Name="ExplorationStatusTextBlock" Style="{StaticResource TooltipExplorationStatus}" Text="{Binding ExplorationStatus}" />
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="ToolTipDiscoveryStatusTemplate">
    <Grid Margin="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <TextBlock Grid.Column="0" Grid.Row="0" Text="{x:Static properties:Resources.Templates_Tooltip_Status}" Style="{StaticResource TooltipTextBlock}" />
      <TextBlock Grid.Column="1" Grid.Row="0" Style="{StaticResource TooltipTextBlockRightAligned}" Text="{Binding ExplorationStatus}" />
      <TextBlock Grid.Column="0" Grid.Row="1" Text="{x:Static properties:Resources.Templates_Tooltip_BodyCount}" Style="{StaticResource TooltipTextBlock}" />
      <TextBlock Grid.Column="1" Grid.Row="1" Style="{StaticResource TooltipTextBlockRightAligned}" Text="{Binding ExploredBodies}" Visibility="{Binding Path=HasNoTotalBodies, Converter={StaticResource BoolToVis}}" />
      <TextBlock Grid.Column="1" Grid.Row="1" Style="{StaticResource TooltipTextBlockRightAligned}" Visibility="{Binding Path=HasTotalBodies, Converter={StaticResource BoolToVis}}">
        <TextBlock.Text>
          <MultiBinding StringFormat="{}{0} of {1}">
            <Binding Path="ExploredBodies" />
            <Binding Path="TotalBodies" />
          </MultiBinding>
        </TextBlock.Text>
      </TextBlock>
      <TextBlock Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" Text="{x:Static properties:Resources.Templates_Tooltip_Journal}" Margin="0,10,0,0" Style="{StaticResource TooltipTextBlockGrey}" />
      <Rectangle Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,2" Style="{StaticResource TooltipRectangleInverse}" />
      <TextBlock Grid.Column="0" Grid.Row="4" Text="{x:Static properties:Resources.Templates_Tooltip_Status}" Style="{StaticResource TooltipTextBlockGrey}" />
      <TextBlock Grid.Column="1" Grid.Row="4" Style="{StaticResource TooltipTextBlockGreyRightAligned}" Text="{Binding JournalExplorationStatus}" />
      <TextBlock Grid.Column="0" Grid.Row="5" Text="{x:Static properties:Resources.Templates_Tooltip_BodyCount}" Style="{StaticResource TooltipTextBlockGrey}" />
      <TextBlock Grid.Column="1" Grid.Row="5" Style="{StaticResource TooltipTextBlockGreyRightAligned}" Text="{Binding ExploredBodyCount}" Visibility="{Binding Path=HasNoTotalBodyCount, Converter={StaticResource BoolToVis}}" />
      <TextBlock Grid.Column="1" Grid.Row="5" Style="{StaticResource TooltipTextBlockGreyRightAligned}" Visibility="{Binding Path=HasTotalBodyCount, Converter={StaticResource BoolToVis}}">
        <TextBlock.Text>
          <MultiBinding StringFormat="{}{0} of {1}">
            <Binding Path="ExploredBodyCount" />
            <Binding Path="TotalBodyCount" />
          </MultiBinding>
        </TextBlock.Text>
      </TextBlock>
      <TextBlock Grid.Column="0" Grid.Row="6" Grid.ColumnSpan="2" Text="{x:Static properties:Resources.Templates_Tooltip_AllBodiesFound}" Style="{StaticResource TooltipTextBlockGrey}" Visibility="{Binding Path=AllBodiesFound, Converter={StaticResource BoolToVis}}" />
      <TextBlock Grid.Column="0" Grid.Row="7" Grid.ColumnSpan="2" Text="{x:Static properties:Resources.Templates_Tooltip_EDSM}" Margin="0,10,0,0" Style="{StaticResource TooltipTextBlockGrey}" />
      <Rectangle Grid.Column="0" Grid.Row="8" Grid.ColumnSpan="2" Margin="0,0,0,2" Style="{StaticResource TooltipRectangleInverse}" />
      <TextBlock Grid.Column="0" Grid.Row="9" Text="{x:Static properties:Resources.Templates_Tooltip_Status}" Style="{StaticResource TooltipTextBlockGrey}" />
      <TextBlock Grid.Column="1" Grid.Row="9" Style="{StaticResource TooltipTextBlockGreyRightAligned}" Text="{Binding EdsmExplorationStatus}" />
      <TextBlock Grid.Column="0" Grid.Row="10" Text="{x:Static properties:Resources.Templates_Tooltip_BodyCount}" Style="{StaticResource TooltipTextBlockGrey}" />
      <TextBlock Grid.Column="1" Grid.Row="10" Style="{StaticResource TooltipTextBlockGreyRightAligned}" Text="{Binding EdsmExploredBodyCount}" Visibility="{Binding Path=HasNoEdsmTotalBodyCount, Converter={StaticResource BoolToVis}}" />
      <TextBlock Grid.Column="1" Grid.Row="10" Style="{StaticResource TooltipTextBlockGreyRightAligned}" Visibility="{Binding Path=HasEdsmTotalBodyCount, Converter={StaticResource BoolToVis}}">
        <TextBlock.Text>
          <MultiBinding StringFormat="{}{0} of {1}">
            <Binding Path="EdsmExploredBodyCount" />
            <Binding Path="EdsmTotalBodyCount" />
          </MultiBinding>
        </TextBlock.Text>
      </TextBlock>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="ToolTipProgressTemplate">
    <Grid Margin="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <TextBlock Grid.Column="0" Grid.Row="0" Text="{x:Static properties:Resources.Templates_Tooltip_CartographicProgress}" Style="{StaticResource TooltipTextBlock}" />
      <TextBlock Grid.Column="1" Grid.Row="0" Style="{StaticResource TooltipTextBlockRightAligned}" Text="{Binding BodiesCartographicProgress}" />
      <TextBlock Grid.Column="0" Grid.Row="1" Text="{x:Static properties:Resources.Templates_Tooltip_ValueAchieved}" Style="{StaticResource TooltipTextBlock}" />
      <TextBlock Grid.Column="1" Grid.Row="1" Style="{StaticResource TooltipTextBlockRightAligned}" Text="{Binding BodiesCartographicValue}" />
      <TextBlock Grid.Column="0" Grid.Row="2" Text="{x:Static properties:Resources.Templates_Tooltip_AchievableValue}" Style="{StaticResource TooltipTextBlockGrey}" Visibility="{Binding BodiesCartographicMaxValueNotReached, Converter={StaticResource BoolToVis}}" />
      <TextBlock Grid.Column="1" Grid.Row="2" Style="{StaticResource TooltipTextBlockGreyRightAligned}" Text="{Binding BodiesCartographicMaxValue}" Visibility="{Binding BodiesCartographicMaxValueNotReached, Converter={StaticResource BoolToVis}}" />
      <Rectangle Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource TooltipRectangle}" Visibility="{Binding HasBodiesBiologicalsCount, Converter={StaticResource BoolToVis}}" />
      <TextBlock Grid.Column="0" Grid.Row="4" Text="{x:Static properties:Resources.Templates_Tooltip_VistaGenomicsProgress}" Style="{StaticResource TooltipTextBlock}" Visibility="{Binding HasBodiesBiologicalsCount, Converter={StaticResource BoolToVis}}" />
      <TextBlock Grid.Column="1" Grid.Row="4" Style="{StaticResource TooltipTextBlockRightAligned}" Text="{Binding BodiesVistaGenomicsProgress}" Visibility="{Binding HasBodiesBiologicalsCount, Converter={StaticResource BoolToVis}}" />
      <TextBlock Grid.Column="0" Grid.Row="5" Text="{x:Static properties:Resources.Templates_Tooltip_ValueAchievedLabel}" Style="{StaticResource TooltipTextBlock}" Visibility="{Binding HasBodiesBiologicalsCount, Converter={StaticResource BoolToVis}}" />
      <TextBlock Grid.Column="1" Grid.Row="5" Style="{StaticResource TooltipTextBlockRightAligned}" Text="{Binding BodiesVistaGenomicsValue}" Visibility="{Binding HasBodiesBiologicalsCount, Converter={StaticResource BoolToVis}}" />
      <TextBlock Grid.Column="0" Grid.Row="6" Text="{x:Static properties:Resources.Templates_Tooltip_BiologicalsAnalyzed}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource TooltipTextBlockGrey}" TargetType="{x:Type TextBlock}">
            <Style.Triggers>
              <DataTrigger Value="False" Binding="{Binding HasBodiesBiologicalsCount}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
              <DataTrigger Value="True" Binding="{Binding BodiesAllGenusesAnalysed}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </TextBlock>
      <TextBlock Grid.Column="1" Grid.Row="6">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource TooltipTextBlockGreyRightAligned}" TargetType="{x:Type TextBlock}">
            <Style.Triggers>
              <DataTrigger Value="False" Binding="{Binding HasBodiesBiologicalsCount}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
              <DataTrigger Value="True" Binding="{Binding BodiesAllGenusesAnalysed}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
        <TextBlock.Text>
          <MultiBinding StringFormat="{}{0} of {1}">
            <Binding Path="BodiesAnalysedGenusesCount" />
            <Binding Path="BodiesBiologicalsCount" />
          </MultiBinding>
        </TextBlock.Text>
      </TextBlock>
      <Rectangle Grid.Column="0" Grid.Row="7" Grid.ColumnSpan="2" Style="{StaticResource TooltipRectangle}" Visibility="{Binding HasBodiesBiologicalsCount, Converter={StaticResource BoolToVis}}" />
      <TextBlock Grid.Column="0" Grid.Row="8" Text="{x:Static properties:Resources.Templates_Tooltip_OverallProgress}" Style="{StaticResource TooltipTextBlock}" Visibility="{Binding HasBodiesBiologicalsCount, Converter={StaticResource BoolToVis}}" />
      <TextBlock Grid.Column="1" Grid.Row="8" Style="{StaticResource TooltipTextBlockRightAligned}" Text="{Binding OverallProgress}" Visibility="{Binding HasBodiesBiologicalsCount, Converter={StaticResource BoolToVis}}" />
      <TextBlock Grid.Column="0" Grid.Row="9" Text="{x:Static properties:Resources.Templates_Tooltip_TotalValueAchieved}" Style="{StaticResource TooltipTextBlock}" Visibility="{Binding HasBodiesBiologicalsCount, Converter={StaticResource BoolToVis}}" />
      <TextBlock Grid.Column="1" Grid.Row="9" Style="{StaticResource TooltipTextBlockRightAligned}" Text="{Binding ExplorationValue}" Visibility="{Binding HasBodiesBiologicalsCount, Converter={StaticResource BoolToVis}}" />
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="ToolTipStarSystemCartographicValueTemplate">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <TextBlock Grid.Column="0" Grid.Row="0" Text="{x:Static properties:Resources.Templates_Tooltip_BaseValue}" Visibility="{Binding HasBodiesCartographicBaseValue, Converter={StaticResource BoolToVis}}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource TooltipTextBlock}" TargetType="{x:Type TextBlock}">
            <Style.Triggers>
              <DataTrigger Value="False" Binding="{Binding WasCompletelyReadFromJournal}">
                <Setter Property="Foreground" Value="{StaticResource HighlightGrey}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </TextBlock>
      <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding BodiesCartographicBaseValue}" Visibility="{Binding HasBodiesCartographicBaseValue, Converter={StaticResource BoolToVis}}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource TooltipTextBlockRightAligned}" TargetType="{x:Type TextBlock}">
            <Style.Triggers>
              <DataTrigger Value="False" Binding="{Binding WasCompletelyReadFromJournal}">
                <Setter Property="Foreground" Value="{StaticResource HighlightGrey}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </TextBlock>
      <TextBlock Grid.Column="0" Grid.Row="1" Text="{x:Static properties:Resources.Templates_Tooltip_SurfaceScanValue}" Visibility="{Binding HasBodiesCartographicSurfaceScanValue, Converter={StaticResource BoolToVis}}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource TooltipTextBlock}" TargetType="{x:Type TextBlock}">
            <Style.Triggers>
              <DataTrigger Value="False" Binding="{Binding WasCompletelySurfaceScanned}">
                <Setter Property="Foreground" Value="{StaticResource HighlightGrey}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </TextBlock>
      <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding BodiesCartographicSurfaceScanValue}" Visibility="{Binding HasBodiesCartographicSurfaceScanValue, Converter={StaticResource BoolToVis}}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource TooltipTextBlockRightAligned}" TargetType="{x:Type TextBlock}">
            <Style.Triggers>
              <DataTrigger Value="False" Binding="{Binding WasCompletelySurfaceScanned}">
                <Setter Property="Foreground" Value="{StaticResource HighlightGrey}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </TextBlock>
      <TextBlock Grid.Column="0" Grid.Row="2" Text="{x:Static properties:Resources.Templates_Tooltip_BonusesValue}" Visibility="{Binding HasBodiesCartographicBonusValue, Converter={StaticResource BoolToVis}}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource TooltipTextBlock}" TargetType="{x:Type TextBlock}">
            <Style.Triggers>
              <DataTrigger Value="True" Binding="{Binding BodiesCartographicMaxValueNotReached}">
                <Setter Property="Foreground" Value="{StaticResource HighlightGrey}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </TextBlock>
      <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding BodiesCartographicBonusValue}" Visibility="{Binding HasBodiesCartographicBonusValue, Converter={StaticResource BoolToVis}}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource TooltipTextBlockRightAligned}" TargetType="{x:Type TextBlock}">
            <Style.Triggers>
              <DataTrigger Value="True" Binding="{Binding BodiesCartographicMaxValueNotReached}">
                <Setter Property="Foreground" Value="{StaticResource HighlightGrey}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </TextBlock>
      <Rectangle Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource TooltipRectangle}" />
      <TextBlock Grid.Column="0" Grid.Row="4" Text="{x:Static properties:Resources.Templates_Tooltip_ValueAchieved}" Style="{StaticResource TooltipTextBlock}" Visibility="{Binding HasBodiesCartographicValue, Converter={StaticResource BoolToVis}}" />
      <TextBlock Grid.Column="1" Grid.Row="4" Style="{StaticResource TooltipTextBlockRightAligned}" Text="{Binding BodiesCartographicValue}" Visibility="{Binding HasBodiesCartographicValue, Converter={StaticResource BoolToVis}}" />
      <TextBlock Grid.Column="0" Grid.Row="5" Text="{x:Static properties:Resources.Templates_Tooltip_AchievableValue}" Style="{StaticResource TooltipTextBlockGrey}" Visibility="{Binding BodiesCartographicMaxValueNotReached, Converter={StaticResource BoolToVis}}" />
      <TextBlock Grid.Column="1" Grid.Row="5" Style="{StaticResource TooltipTextBlockGreyRightAligned}" Text="{Binding BodiesCartographicMaxValue}" Visibility="{Binding BodiesCartographicMaxValueNotReached, Converter={StaticResource BoolToVis}}" />
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="ToolTipBodyInfoTemplate">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,7,0" Text="{x:Static properties:Resources.Templates_Tooltip_Radius}" Visibility="{Binding Path=HasRadius, Converter={StaticResource BoolToVis}}" />
      <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Radius}" Visibility="{Binding Path=HasRadius, Converter={StaticResource BoolToVis}}" />
      <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,7,0" Text="{x:Static properties:Resources.Templates_Tooltip_Gravity}" Visibility="{Binding Path=HasGravity, Converter={StaticResource BoolToVis}}" />
      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Gravity}" Visibility="{Binding Path=HasGravity, Converter={StaticResource BoolToVis}}" />
      <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,7,0" Text="{x:Static properties:Resources.Templates_Tooltip_Mass}" Visibility="{Binding Path=HasMass, Converter={StaticResource BoolToVis}}" />
      <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Mass}" Visibility="{Binding Path=HasMass, Converter={StaticResource BoolToVis}}" />
      <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,7,0" Text="{x:Static properties:Resources.Templates_Tooltip_OrbitalInclination}" Visibility="{Binding Path=HasOrbitalInclination, Converter={StaticResource BoolToVis}}" />
      <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding OrbitalInclination}" Visibility="{Binding Path=HasOrbitalInclination, Converter={StaticResource BoolToVis}}" />
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="ToolTipBodyCartographicValueTemplate">
    <Grid Margin="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <TextBlock Grid.Column="0" Grid.Row="0" Text="{x:Static properties:Resources.Templates_Tooltip_BaseValue}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource TooltipTextBlock}" TargetType="{x:Type TextBlock}">
            <Style.Triggers>
              <DataTrigger Value="True" Binding="{Binding WasReadFromEdsmOnly}">
                <Setter Property="Foreground" Value="{StaticResource HighlightGrey}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </TextBlock>
      <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding CartographicBaseValue}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource TooltipTextBlockRightAligned}" TargetType="{x:Type TextBlock}">
            <Style.Triggers>
              <DataTrigger Value="True" Binding="{Binding WasReadFromEdsmOnly}">
                <Setter Property="Foreground" Value="{StaticResource HighlightGrey}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </TextBlock>
      <TextBlock Grid.Column="0" Grid.Row="1" Text="{x:Static properties:Resources.Templates_Tooltip_FirstDiscoveryBonus}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource TooltipTextBlock}" TargetType="{x:Type TextBlock}">
            <Style.Triggers>
              <DataTrigger Value="True" Binding="{Binding WasDiscovered}">
                <Setter Property="Foreground" Value="{StaticResource InactiveMainColor}" />
                <Setter Property="TextDecorations" Value="Strikethrough" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </TextBlock>
      <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding CartographicFirstDiscoveryBonusRange}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource TooltipTextBlockRightAligned}" TargetType="{x:Type TextBlock}">
            <Style.Triggers>
              <DataTrigger Value="True" Binding="{Binding WasDiscovered}">
                <Setter Property="Foreground" Value="{StaticResource InactiveMainColor}" />
                <Setter Property="TextDecorations" Value="Strikethrough" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </TextBlock>
      <TextBlock Grid.Column="0" Grid.Row="2" Text="{x:Static properties:Resources.Templates_Tooltip_SurfaceScanValue}" Visibility="{Binding Path=IsPlanet, Converter={StaticResource BoolToVis}}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource TooltipTextBlock}" TargetType="{x:Type TextBlock}">
            <Style.Triggers>
              <DataTrigger Value="False" Binding="{Binding SurfaceScanned}">
                <Setter Property="Foreground" Value="{StaticResource HighlightGrey}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </TextBlock>
      <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding CartographicSurfaceScanValue}" Visibility="{Binding Path=IsPlanet, Converter={StaticResource BoolToVis}}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource TooltipTextBlockRightAligned}" TargetType="{x:Type TextBlock}">
            <Style.Triggers>
              <DataTrigger Value="False" Binding="{Binding SurfaceScanned}">
                <Setter Property="Foreground" Value="{StaticResource HighlightGrey}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </TextBlock>
      <TextBlock Grid.Column="0" Grid.Row="3" Text="{x:Static properties:Resources.Templates_Tooltip_FirstSurfaceScanBonus}" Visibility="{Binding Path=IsPlanet, Converter={StaticResource BoolToVis}}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource TooltipTextBlock}" TargetType="{x:Type TextBlock}">
            <Style.Triggers>
              <DataTrigger Value="True" Binding="{Binding WasMapped}">
                <Setter Property="Foreground" Value="{StaticResource InactiveMainColor}" />
                <Setter Property="TextDecorations" Value="Strikethrough" />
              </DataTrigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Value="False" Binding="{Binding WasMapped}" />
                  <Condition Value="False" Binding="{Binding SurfaceScanned}" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Foreground" Value="{StaticResource HighlightGrey}" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </TextBlock>
      <TextBlock Grid.Column="1" Grid.Row="3" Text="{Binding CartographicFirstSurfaceScanBonusValue}" Visibility="{Binding Path=IsPlanet, Converter={StaticResource BoolToVis}}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource TooltipTextBlockRightAligned}" TargetType="{x:Type TextBlock}">
            <Style.Triggers>
              <DataTrigger Value="True" Binding="{Binding WasMapped}">
                <Setter Property="Foreground" Value="{StaticResource InactiveMainColor}" />
                <Setter Property="TextDecorations" Value="Strikethrough" />
              </DataTrigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Value="False" Binding="{Binding WasMapped}" />
                  <Condition Value="False" Binding="{Binding SurfaceScanned}" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Foreground" Value="{StaticResource HighlightGrey}" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </TextBlock>
      <TextBlock Grid.Column="0" Grid.Row="4" Text="{x:Static properties:Resources.Templates_Tooltip_EfficientlyScannedBonus}" Visibility="{Binding Path=IsPlanet, Converter={StaticResource BoolToVis}}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource TooltipTextBlock}" TargetType="{x:Type TextBlock}">
            <Style.Triggers>
              <DataTrigger Value="False" Binding="{Binding SurfaceScanned}">
                <Setter Property="Foreground" Value="{StaticResource HighlightGrey}" />
              </DataTrigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Value="True" Binding="{Binding SurfaceScanned}" />
                  <Condition Value="False" Binding="{Binding EfficientlyScanned}" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Foreground" Value="{StaticResource InactiveMainColor}" />
                <Setter Property="TextDecorations" Value="Strikethrough" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </TextBlock>
      <TextBlock Grid.Column="1" Grid.Row="4" Text="{Binding CartographicEfficientlyScannedBonusValue}" Visibility="{Binding Path=IsPlanet, Converter={StaticResource BoolToVis}}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource TooltipTextBlockRightAligned}" TargetType="{x:Type TextBlock}">
            <Style.Triggers>
              <DataTrigger Value="False" Binding="{Binding SurfaceScanned}">
                <Setter Property="Foreground" Value="{StaticResource HighlightGrey}" />
              </DataTrigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Value="True" Binding="{Binding SurfaceScanned}" />
                  <Condition Value="False" Binding="{Binding EfficientlyScanned}" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Foreground" Value="{StaticResource InactiveMainColor}" />
                <Setter Property="TextDecorations" Value="Strikethrough" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </TextBlock>
      <Rectangle Grid.Column="0" Grid.Row="5" Grid.ColumnSpan="2" Style="{StaticResource TooltipRectangle}" />
      <TextBlock Grid.Column="0" Grid.Row="6" Text="{x:Static properties:Resources.Templates_Tooltip_ValueAchieved}" Style="{StaticResource TooltipTextBlock}" Visibility="{Binding Path=HasCartographicValue, Converter={StaticResource BoolToVis}}" />
      <TextBlock Grid.Column="1" Grid.Row="6" Style="{StaticResource TooltipTextBlockRightAligned}" Text="{Binding CartographicValue}" Visibility="{Binding Path=HasCartographicValue, Converter={StaticResource BoolToVis}}" />
      <TextBlock Grid.Column="0" Grid.Row="7" Text="{x:Static properties:Resources.Templates_Tooltip_AchievableValue}" Style="{StaticResource TooltipTextBlockGrey}" Visibility="{Binding Path=CartographicMaxValueNotReached, Converter={StaticResource BoolToVis}}" />
      <TextBlock Grid.Column="1" Grid.Row="7" Style="{StaticResource TooltipTextBlockGreyRightAligned}" Text="{Binding CartographicMaxValue}" Visibility="{Binding Path=CartographicMaxValueNotReached, Converter={StaticResource BoolToVis}}" />
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="HeaderPlanetOfInterestTemplate">
