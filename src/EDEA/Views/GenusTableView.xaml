<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="EDEA.Views.GenusTableView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:EDEA.Views" xmlns:mns="clr-namespace:EDEA" xmlns:core="clr-namespace:EDEA;assembly=EDEA.Core" xmlns:viewmodels="clr-namespace:EDEA.ViewModels" xmlns:properties="clr-namespace:EDEA.Properties;assembly=EDEA.Core">
  <Grid>
    <Border Style="{StaticResource TabViewBorder}" />
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="auto" />
        <RowDefinition Height="auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Style="{StaticResource TableViewInfoBanner}" Text="{Binding UnknownBiologicalsInfo}" Visibility="{Binding Path=AreBiologicalsUnknown, Converter={StaticResource BoolToVis}}" />
      <DataGrid Name="GenusDataGrid" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Hidden" ItemsSource="{Binding Genuses}" Visibility="{Binding Path=AreBiologicalsKnown, Converter={StaticResource BoolToVis}}">
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource MainScrollBarStyle}" />
            <mns:BindingProxy x:Key="proxy" Data="{Binding}" />
          </ResourceDictionary>
        </FrameworkElement.Resources>
        <DataGrid.RowStyle>
          <Style BasedOn="{StaticResource DataGridRowStyle}" TargetType="{x:Type DataGridRow}" />
        </DataGrid.RowStyle>
        <DataGrid.Columns>
          <DataGridTextColumn ElementStyle="{StaticResource TextColumnBasicStyle}" Header="{x:Static core:Globals.ColumnHeaderName}" Binding="{Binding Name}" />
          <DataGridTextColumn ElementStyle="{StaticResource TextColumnBasicStyle}" Header="{x:Static core:Globals.ColumnHeaderSpecies}" Binding="{Binding SpeciesShort}" />
          <DataGridTextColumn ElementStyle="{StaticResource TextColumnBasicStyle}" Header="{x:Static core:Globals.ColumnHeaderVariant}" Binding="{Binding VariantShort}" />
          <DataGridTemplateColumn SortMemberPath="AnalysisComplete" CellTemplate="{StaticResource IconGenusAnalysisCompleteTemplate}" HeaderTemplate="{StaticResource HeaderAnalysisCompleteTemplate}" HeaderStyle="{StaticResource DataGridColumnHeaderAnalysisCompleteStyle}" />
          <DataGridTextColumn ElementStyle="{StaticResource TextColumnBasicStyle}" Header="{x:Static core:Globals.ColumnHeaderScans}" Binding="{Binding ScanCount}" />
          <DataGridTextColumn ElementStyle="{StaticResource TextColumnAlignedRight}" Header="{x:Static core:Globals.ColumnHeaderClonalColonyRange}" Binding="{Binding ClonalColonyRange}" />
          <DataGridTemplateColumn CellTemplate="{StaticResource TextGenus1stScanDistanceTemplate}" Header="{x:Static core:Globals.ColumnHeader1stScanDistance}" HeaderStyle="{StaticResource DataGridColumnHeaderBasicStyle}" Visibility="{Binding Data.GeneraInAnalysisAvailabe, Source={StaticResource proxy}, Converter={StaticResource BoolToVis}}" />
          <DataGridTemplateColumn CellTemplate="{StaticResource TextGenus2ndScanDistanceTemplate}" Header="{x:Static core:Globals.ColumnHeader2ndScanDistance}" HeaderStyle="{StaticResource DataGridColumnHeaderBasicStyle}" Visibility="{Binding Data.GeneraInAnalysisAvailabe, Source={StaticResource proxy}, Converter={StaticResource BoolToVis}}" />
          <DataGridTemplateColumn SortMemberPath="VistaGenomicsValueSort" CellTemplate="{StaticResource TextGenusVistaGenomicsValueTemplate}" Header="{x:Static core:Globals.ColumnHeaderVistaGenomicsValue}" HeaderStyle="{StaticResource DataGridColumnHeaderBasicStyle}" />
          <DataGridTemplateColumn SortMemberPath="IsValuableGenus" CellTemplate="{StaticResource IconGenusValuableTemplate}" HeaderTemplate="{StaticResource HeaderValuableTemplate}" HeaderStyle="{StaticResource DataGridColumnHeaderValuableGenusStyle}" />
          <DataGridTemplateColumn SortMemberPath="IsFirstDiscoveryAndSpeciesSet" CellTemplate="{StaticResource IconGenusFirstDiscoveryTemplate}" HeaderTemplate="{StaticResource HeaderNewTemplate}" HeaderStyle="{StaticResource DataGridColumnHeaderNewStyle}" />
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Grid.Row="1" Text="{x:Static properties:Resources.GenusTable_PossibleOccurrences}" Style="{StaticResource TableViewDataGridHeadline}" Visibility="{Binding Path=PredictedSpeciesAvailable, Converter={StaticResource BoolToVis}}" />
      <Border Grid.Row="2" Style="{StaticResource TabViewInverseBorder}" Visibility="{Binding Path=PredictedSpeciesAvailable, Converter={StaticResource BoolToVis}}" />
      <DataGrid Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Hidden" Style="{StaticResource DataGridInverseStyle}" ItemsSource="{Binding PredictedSpecies}" Visibility="{Binding Path=PredictedSpeciesAvailable, Converter={StaticResource BoolToVis}}">
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource InverseScrollBarStyle}" />
          </ResourceDictionary>
        </FrameworkElement.Resources>
        <DataGrid.RowStyle>
          <Style BasedOn="{StaticResource DataGridRowInverseStyle}" TargetType="{x:Type DataGridRow}" />
        </DataGrid.RowStyle>
        <DataGrid.CellStyle>
          <Style BasedOn="{StaticResource DataGridCellInverseStyle}" TargetType="{x:Type DataGridCell}" />
        </DataGrid.CellStyle>
        <DataGrid.ColumnHeaderStyle>
          <Style BasedOn="{StaticResource DataGridColumnHeaderInverseStyle}" TargetType="{x:Type DataGridColumnHeader}" />
        </DataGrid.ColumnHeaderStyle>
        <DataGrid.Columns>
          <DataGridTextColumn ElementStyle="{StaticResource TextColumnInverseStyle}" Header="{x:Static core:Globals.ColumnHeaderName}" Binding="{Binding Name}" />
          <DataGridTextColumn ElementStyle="{StaticResource TextColumnInverseStyle}" Header="{x:Static core:Globals.ColumnHeaderSpecies}" Binding="{Binding SpeciesShort}" />
          <DataGridTextColumn SortMemberPath="ClonalColonyRangeSort" ElementStyle="{StaticResource TextColumnInverseAlignedRight}" Header="{x:Static core:Globals.ColumnHeaderClonalColonyRange}" Binding="{Binding ClonalColonyRange}" />
          <DataGridTemplateColumn SortMemberPath="VistaGenomicsMaxValueSort" CellTemplate="{StaticResource TextPredictedSpeciesVistaGenomicsValueTemplate}" Header="{x:Static core:Globals.ColumnHeaderVistaGenomicsValue}" />
          <DataGridTemplateColumn SortMemberPath="IsValuableGenus" CellTemplate="{StaticResource IconPredictedSpeciesValuableTemplate}" HeaderTemplate="{StaticResource HeaderValuableTemplate}" HeaderStyle="{StaticResource DataGridColumnHeaderValuableGenusInverseStyle}" />
          <DataGridTemplateColumn CellTemplate="{StaticResource IconPredictedSpeciesFirstDiscoveryTemplate}" HeaderTemplate="{StaticResource HeaderNewTemplate}" HeaderStyle="{StaticResource DataGridColumnHeaderNewInverseStyle}" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </Grid>
</UserControl>