                              <GridViewRowPresenter HorizontalAlignment="Stretch" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" Width="Auto" Margin="0" Content="{TemplateBinding ContentControl.Content}" />
                            </Border>
                          </ControlTemplate>
                        </Setter.Value>
