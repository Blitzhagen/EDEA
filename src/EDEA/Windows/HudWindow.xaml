<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="EDEA.Windows.HudWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:EDEA;assembly=EDEA.Core" xmlns:properties="clr-namespace:EDEA.Properties;assembly=EDEA.Core" xmlns:views="clr-namespace:EDEA.Views" xmlns:converter="clr-namespace:EDEA.Converters" xmlns:viewmodels="clr-namespace:EDEA.ViewModels;assembly=EDEA.Core" xmlns:wpfviewmodels="clr-namespace:EDEA.ViewModels" Title="{x:Static properties:Resources.HudWindow_Title}" Height="800" Width="400" MinHeight="170" MinWidth="240" Topmost="True" WindowStartupLocation="CenterOwner" AllowsTransparency="True" Background="#00FFFFFF" WindowStyle="None" ResizeMode="CanResizeWithGrip" Focusable="False" xmlns:windows="clr-namespace:EDEA.Windows">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="{x:Type ResizeGrip}" TargetType="{x:Type ResizeGrip}">
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ResizeGrip}">
              <Border Background="{TemplateBinding Control.Background}" SnapsToDevicePixels="True" Width="25" Height="25" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <converter:SystemExplorationStatusToBrushColorConverter x:Key="SystemExplorationStatusToBrushColorConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="#00FFFFFF">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Rectangle Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3" Grid.RowSpan="3" Style="{StaticResource HudBackground}" Opacity="{Binding Source={x:Static local:Preferences.HudWindow}, Path=Opacity, Mode=OneWay}" />
    <Rectangle Name="HudWindowMoveGrabber" Panel.ZIndex="100" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" Fill="#00FFFFFF" Height="25" VerticalAlignment="Top" />
    <StackPanel Grid.Column="0" Grid.Row="0">
      <TextBlock Style="{StaticResource HudSystemInfo}" Text="{Binding SystemName}" />
      <StackPanel Orientation="Horizontal">
        <TextBlock Style="{StaticResource HudViewInfo}" Text="{Binding BodyExplorationStatus}" />
        <Grid>
          <Rectangle Width="{Binding Width, ElementName=textBlock}" Height="{Binding Height, ElementName=textBlock}">
            <FrameworkElement.Style>
              <Style BasedOn="{StaticResource HudSystemExplorationInfoBubble}" TargetType="{x:Type Rectangle}">
                <Setter Property="Fill" Value="{Binding Path=CurrentSystemViewModel, Converter={StaticResource SystemExplorationStatusToBrushColorConverter}}" />
              </Style>
            </FrameworkElement.Style>
          </Rectangle>
          <TextBlock Name="textBlock" Style="{StaticResource HudSystemExplorationInfo}" Text="{Binding ExplorationStatus}">
            <FrameworkElement.ToolTip>
              <ContentControl ContentTemplate="{StaticResource ToolTipDiscoveryStatusTemplate}" Content="{Binding Path=CurrentSystemViewModel}" />
            </FrameworkElement.ToolTip>
          </TextBlock>
        </Grid>
      </StackPanel>
      <TextBlock Style="{StaticResource HudViewInfo}" Text="{Binding NonBodyExplorationStatus}" />
      <TextBlock Style="{StaticResource HudViewInfo}" Padding="0,6,0,2" Text="{Binding TableHeadline}" />
    </StackPanel>
    <Button Name="CloseHudWindowButton" Grid.Column="2" Grid.Row="0" Style="{StaticResource WindowIconButtonHudStyle}" ContentTemplate="{StaticResource CloseIcon}" Foreground="{StaticResource CloseIconColor}" Command="{Binding CloseHudWindowCommand}" />
    <Grid Column="0" Row="1" ColumnSpan="3" RowSpan="2">
      <FrameworkElement.Resources>
        <ResourceDictionary>
          <DataTemplate x:Key="{DataTemplateKey {x:Type viewmodels:BodyTableViewModel}}" DataType="{x:Type viewmodels:BodyTableViewModel}">
            <views:BodyHudTableView />
          </DataTemplate>
          <DataTemplate x:Key="{DataTemplateKey {x:Type wpfviewmodels:NavRouteTableViewModel}}" DataType="{x:Type wpfviewmodels:NavRouteTableViewModel}">
            <views:NavRouteHudTableView />
          </DataTemplate>
          <DataTemplate x:Key="{DataTemplateKey {x:Type viewmodels:GenusTableViewModel}}" DataType="{x:Type viewmodels:GenusTableViewModel}">
            <views:GenusHudTableView />
          </DataTemplate>
        </ResourceDictionary>
      </FrameworkElement.Resources>
      <ContentControl Content="{Binding CurrentViewModel}" />
    </Grid>
    <Button Name="ResizeHudWindowButton" Grid.Column="2" Grid.Row="2" ContentTemplate="{StaticResource ResizeIcon}" Foreground="{StaticResource ResizeIconColor}" Style="{StaticResource WindowIconButtonHudStyle}" />
  </Grid>
</Window>
