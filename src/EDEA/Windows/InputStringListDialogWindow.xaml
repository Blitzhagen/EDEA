<Window x:Class="EDEA.Windows.InputStringListDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:EDEA.Properties;assembly=EDEA.Core"
        Title="{x:Static properties:Resources.InputStringListDialogWindow_Title}" Height="300" Width="420"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource ForegroundBrush}"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="PromptTextBlock" FontSize="14" Foreground="{StaticResource DimForegroundBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <ListBox Grid.Row="1" x:Name="ValuesListBox" Margin="0,0,0,12" SelectionMode="Multiple"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static properties:Resources.InputStringListDialogWindow_OK}" Padding="16,4" Margin="0,0,10,0" Click="OkButton_Click" IsDefault="True"/>
            <Button Content="{x:Static properties:Resources.InputStringListDialogWindow_Cancel}" Padding="16,4" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
