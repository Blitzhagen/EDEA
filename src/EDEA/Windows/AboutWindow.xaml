<Window x:Class="EDEA.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:EDEA.Properties"
        Title="{x:Static properties:Resources.AboutWindow_Title}" Height="260" Width="420"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource ForegroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{x:Static properties:Resources.AboutWindow_AppName}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="1" Text="{x:Static properties:Resources.AboutWindow_Version}" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="2" Text="{x:Static properties:Resources.AboutWindow_Description}" Foreground="{StaticResource DimForegroundBrush}" Margin="0,0,0,16" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="3" Text="{x:Static properties:Resources.AboutWindow_License}" Foreground="{StaticResource DimForegroundBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>
        <Button Grid.Row="4" Content="{x:Static properties:Resources.AboutWindow_OK}" HorizontalAlignment="Right" Padding="16,4" Click="OkButton_Click"/>
    </Grid>
</Window>
