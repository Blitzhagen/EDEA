<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="EDEA.Windows.RoutePlotterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EDEA"
        xmlns:properties="clr-namespace:EDEA.Properties"
        Background="{StaticResource MainBackgroundColor}"
        SizeToContent="WidthAndHeight"
        MinWidth="50"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        Title="{Binding WindowTitle}">
  <Grid>
    <Grid Name="NoShipDataMessageGrid" Panel.ZIndex="103" Visibility="{Binding HasNoShipData, Converter={StaticResource BoolToVis}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="70" />
      </Grid.RowDefinitions>
      <Rectangle Grid.RowSpan="2" Fill="{StaticResource MainBackgroundColor}" />
      <Grid Grid.Row="0" Visibility="{Binding HasNoShipData, Converter={StaticResource BoolToVis}}">
        <TextBlock Style="{StaticResource AboutContent}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Text="{x:Static properties:Resources.RoutePlotterWindow_NoShipData}" />
      </Grid>
      <Button Grid.Row="1" Style="{StaticResource UpdateButton}" VerticalAlignment="Top" Content="{x:Static properties:Resources.RoutePlotterWindow_Cancel}" Command="{Binding CancelButtonCommand}" />
    </Grid>
    <Grid Name="ErrorMessageGrid" Panel.ZIndex="102" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="70" />
      </Grid.RowDefinitions>
      <Rectangle Grid.RowSpan="2" Fill="{StaticResource MainBackgroundColor}" />
      <Grid Grid.Row="0">
        <TextBlock Style="{StaticResource AboutContent}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Text="{x:Static properties:Resources.RoutePlotterWindow_ErrorMessage}" />
      </Grid>
      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
        <Button Name="TryAgainErrorButton" Style="{StaticResource UpdateButton}" Content="{x:Static properties:Resources.RoutePlotterWindow_TryAgain}" />
        <Button Style="{StaticResource UpdateButton}" Content="{x:Static properties:Resources.RoutePlotterWindow_Cancel}" Command="{Binding CancelButtonCommand}" />
      </StackPanel>
    </Grid>
    <Grid Name="LoadingMessageGrid" Panel.ZIndex="101" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="70" />
      </Grid.RowDefinitions>
      <Rectangle Grid.RowSpan="2" Fill="{StaticResource MainBackgroundColor}" />
      <Grid Grid.Row="0">
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center">
          <Grid Margin="4,0,0,17">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar Name="LoadingProgressBar" Minimum="0" Maximum="60" Value="0" Grid.Column="0" Height="22" VerticalAlignment="Center" Style="{StaticResource ProgressBarGeneric}" />
            <Button Grid.Column="1" ContentTemplate="{StaticResource LoadingIconAnimated}" Style="{StaticResource IconButtonStyle}" />
          </Grid>
          <TextBlock Style="{StaticResource AboutContent}">
            <Run Text="{x:Static properties:Resources.RoutePlotterWindow_Loading_Part1}" />
            <Run Text="{x:Static local:Globals.PlotterUrl}" />
            <LineBreak />
            <Run Text="{x:Static properties:Resources.RoutePlotterWindow_Loading_Line2}" />
            <LineBreak /><LineBreak />
            <Run Text="{x:Static properties:Resources.RoutePlotterWindow_Loading_Line4}" />
            <LineBreak />
            <Run Text="{x:Static properties:Resources.RoutePlotterWindow_Loading_Line5}" />
          </TextBlock>
        </StackPanel>
      </Grid>
      <Button Grid.Row="1" Style="{StaticResource UpdateButton}" VerticalAlignment="Top" Content="{x:Static properties:Resources.RoutePlotterWindow_Cancel}" Command="{Binding CancelButtonCommand}" />
    </Grid>
    <Grid Margin="17,16,17,0" Panel.ZIndex="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="auto" />
        <RowDefinition Height="auto" />
        <RowDefinition Height="70" />
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0">
        <Border Background="{StaticResource MainCellColor}" Padding="3,7,3,12" Margin="0,0,0,17" CornerRadius="7">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>
              <TextBlock Grid.Column="0" Grid.Row="0" Text="{x:Static properties:Resources.RoutePlotterWindow_ShipName}" Style="{StaticResource AboutHeader}" />
              <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal">
                <TextBlock Style="{StaticResource PlotterContent}" Text="{Binding CurrentShip.Name}" />
                <TextBlock Style="{StaticResource PlotterContent}">(<Run Text="{Binding CurrentShip.Identification, Mode=OneWay}" />)</TextBlock>
              </StackPanel>
              <TextBlock Grid.Column="0" Grid.Row="1" Text="{x:Static properties:Resources.RoutePlotterWindow_FrameShiftDrive}" Style="{StaticResource AboutHeader}" />
              <TextBlock Grid.Column="1" Grid.Row="1" Style="{StaticResource PlotterContent}"><Run Text="{x:Static properties:Resources.RoutePlotterWindow_Class}" /> <Run Text="{Binding CurrentShip.FrameShiftDrive.Class, Mode=OneWay}" />, <Run Text="{x:Static properties:Resources.RoutePlotterWindow_Rating}" /> <Run Text="{Binding CurrentShip.FrameShiftDrive.Rating, Mode=OneWay}" /></TextBlock>
              <TextBlock Grid.Column="0" Grid.Row="2" Text="{x:Static properties:Resources.RoutePlotterWindow_FsdBooster}" Style="{StaticResource AboutHeader}" />
              <TextBlock Grid.Column="1" Grid.Row="2" Style="{StaticResource PlotterContent}" Text="{Binding InfoBooster}" />
            </Grid>
            <Grid Margin="35,0,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>
              <TextBlock Grid.Column="0" Grid.Row="0" Text="{x:Static properties:Resources.RoutePlotterWindow_CargoCount}" Style="{StaticResource AboutHeader}" />
              <TextBlock Grid.Column="1" Grid.Row="0" Style="{StaticResource PlotterContent}">
                <Run Text="{Binding CurrentShip.CargoCount, Mode=OneWay}" /> t</TextBlock>
              <TextBlock Grid.Column="0" Grid.Row="2" Text="{x:Static properties:Resources.RoutePlotterWindow_Supercharged}" Style="{StaticResource AboutHeader}" />
              <TextBlock Grid.Column="1" Grid.Row="2" Style="{StaticResource PlotterContent}" Text="{Binding InfoSupercharged}" />
              <TextBlock Grid.Column="0" Grid.Row="1" Text="{x:Static properties:Resources.RoutePlotterWindow_FsdOptimalMass}" Style="{StaticResource AboutHeader}" />
              <TextBlock Grid.Column="1" Grid.Row="1" Style="{StaticResource PlotterContent}">
                <Run Text="{Binding CurrentShip.FrameShiftDrive.OptimalMass, Mode=OneWay}" /> t</TextBlock>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
        <Grid Width="340">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static properties:Resources.RoutePlotterWindow_SourceSystem}" Style="{StaticResource AboutHeader}" />
          <TextBlock Name="SourceSystemTextBlock" Grid.Row="0" Grid.Column="1" Height="21" Padding="5,3,0,0" Margin="1,2,0,5" Background="#FFFFFFFF" Focusable="True" Text="{Binding Path=SelectedSourceSystem.Name}">
            <Popup Name="SourceSystemSearchPopUp" Placement="Relative" IsOpen="True" PlacementTarget="{Binding ElementName=SourceSystemTextBlock}">
              <StackPanel Grid.Row="0" Grid.Column="1">
                <TextBox Name="SourceSystemSearchTextBox" Width="{Binding ElementName=SourceSystemTextBlock, Path=ActualWidth}" Height="{Binding ElementName=SourceSystemTextBlock, Path=ActualHeight}" />
                <ListBox Name="SourceSystemSearchResultListBox" Height="120" Width="{Binding ElementName=SourceSystemTextBlock, Path=ActualWidth}" ItemsSource="{Binding SelectableSourceSystems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Popup>
          </TextBlock>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static properties:Resources.RoutePlotterWindow_DestinationSystem}" Style="{StaticResource AboutHeader}" />
          <TextBlock Name="TargetSystemTextBlock" Grid.Row="1" Grid.Column="1" Background="#FFFFFFFF" Focusable="True" Height="{Binding ElementName=SourceSystemTextBlock, Path=ActualHeight}" Padding="{Binding ElementName=SourceSystemTextBlock, Path=Padding}" Margin="{Binding ElementName=SourceSystemTextBlock, Path=Margin}" Text="{Binding Path=SelectedTargetSystem.Name}">
            <Popup Name="TargetSystemSearchPopUp" Placement="Relative" IsOpen="True" PlacementTarget="{Binding ElementName=TargetSystemTextBlock}">
              <StackPanel Grid.Row="0" Grid.Column="1">
                <TextBox Name="TargetSystemSearchTextBox" Width="{Binding ElementName=TargetSystemTextBlock, Path=ActualWidth}" Height="{Binding ElementName=TargetSystemTextBlock, Path=ActualHeight}" />
                <ListBox Name="TargetSystemSearchResultListBox" Height="120" Width="{Binding ElementName=TargetSystemTextBlock, Path=ActualWidth}" ItemsSource="{Binding SelectableTargetSystems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Popup>
          </TextBlock>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static properties:Resources.RoutePlotterWindow_Efficiency}" Style="{StaticResource AboutHeader}" />
          <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBox Text="{Binding Source={x:Static local:Preferences.Spansh}, Path=Efficiency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="50" Height="{Binding ElementName=SourceSystemTextBlock, Path=ActualHeight}" Margin="{Binding ElementName=SourceSystemTextBlock, Path=Margin}" VerticalContentAlignment="Center" />
            <Slider Minimum="10" Maximum="100" Value="{Binding Source={x:Static local:Preferences.Spansh}, Path=Efficiency, Mode=TwoWay}" Width="120" VerticalAlignment="Center" Margin="5,0,0,0" />
          </StackPanel>
        </Grid>
      </StackPanel>
      <Button Name="GenerateRouteButton" Grid.Row="2" VerticalAlignment="Top" Style="{StaticResource UpdateButton}" Content="{x:Static properties:Resources.RoutePlotterWindow_GenerateRoute}" IsEnabled="{Binding IsSelectionValid}" />
    </Grid>
  </Grid>
</Window>
